  $('#btnUpdApply').onclick = (e) => confirmModal('Apply verified update', '<div class="sh-note warn"><svg width="15" height="15" style="flex-shrink:0;margin-top:1px"><use href="#sh-i-alert"/></svg><div>The updater will: verify signature + every file hash, create a pre-update backup, snapshot changed files for rollback, apply, then syntax-validate the result and roll back automatically on failure. A service restart is required afterwards.</div></div>', 'Apply update', true, async () => {
    const p = updPaths();
    if (!p.zipPath || !p.manifestPath) return toast('Both paths required', 'err');
    const r = await guarded(null, () => api('/api/shield/update/apply', { method: 'POST', body: { confirm: true, ...p } }));
    if (r) { toast(r.ok ? 'Update applied (' + r.filesChanged + ' files) — restart the panel' : 'Update failed: ' + (r.error || r.errors || ''), r.ok ? '' : 'err'); loadUpdates(); }
  });
  $('#btnUpdRollback').onclick = (e) => confirmModal('Roll back last update', '<div class="sh-note warn"><svg width="15" height="15" style="flex-shrink:0;margin-top:1px"><use href="#sh-i-alert"/></svg><div>Files changed by the last update are restored from the automatic rollback snapshot. A service restart is required afterwards.</div></div>', 'Roll back', true, async () => {
    const r = await guarded(null, () => api('/api/shield/update/rollback', { method: 'POST', body: { confirm: true } }));
    if (r) { toast(r.ok ? 'Rolled back (' + r.restored + ' files) — restart the panel' : 'Rollback failed: ' + (r.error || ''), r.ok ? '' : 'err'); loadUpdates(); }
  });

  // ---------- settings ----------
  let settingDefs = [];
  async function loadSettings() {
    if (!IS_OWNER) return;
    const d = await guarded(null, () => api('/api/shield/settings'));
    if (!d) return;
    settingDefs = d.settings;
    const groups = {
      general: ['shield.integrity.mode', 'shield.integrity.scheduleMinutes', 'shield.security.sshFailThreshold', 'shield.security.sshWindowMinutes', 'shield.recovery.maxAttempts', 'shield.recovery.cooldownMinutes'],
      notify: ['shield.notify.minSeverity', 'shield.notify.discord.webhook', 'shield.notify.telegram.token', 'shield.notify.telegram.chatId', 'shield.notify.webhook.url', 'shield.notify.email.host', 'shield.notify.email.port', 'shield.notify.email.security', 'shield.notify.email.user', 'shield.notify.email.pass', 'shield.notify.email.from', 'shield.notify.email.to'],
      backup: ['shield.backup.scheduleHours', 'shield.backup.keep', 'shield.backup.remote.target', 'shield.backup.remote.key'],
      update: ['shield.update.publicKey', 'shield.update.allowUnsigned'],
    };
    const render = (ids) => ids.map((k) => {
      const def = settingDefs.find((x) => x.key === k);
      if (!def) return '';
      const val = def.value == null ? def.def : def.value;
      let input;
      if (def.type === 'select') input = '<select class="sh-input sh-setting" data-key="' + def.key + '">' + def.options.map((o) => '<option value="' + esc(o) + '"' + (String(val) === String(o) ? ' selected' : '') + '>' + esc(o) + '</option>').join('') + '</select>';
      else if (def.type === 'textarea') input = '<textarea class="sh-textarea sh-setting" data-key="' + def.key + '">' + esc(val) + '</textarea>';
      else input = '<input class="sh-input sh-setting" data-key="' + def.key + '" type="' + (def.type === 'password' ? 'password' : 'text') + '" value="' + esc(val) + '" autocomplete="new-password">';
      return '<div class="sh-field"><label>' + esc(def.label) + (def.isDefault ? ' <span class="sh-tag">default</span>' : '') + '</label>' + input + '</div>';
    }).join('');
    $('#setGeneral').innerHTML = render(groups.general);
    $('#setNotify').innerHTML = render(groups.notify) + '<div class="sh-flex" style="gap:6px;flex-wrap:wrap;margin-top:4px"><span style="font-size:12px;color:var(--sh-text-dim)">test a channel:</span>' + ['discord', 'telegram', 'webhook', 'email'].map((c) => '<button class="sh-btn sm ghost" data-test="' + c + '">' + c + '</button>').join('') + '</div>';
    $('#setBackup').innerHTML = render(groups.backup) + '<div class="sh-note info" style="margin-top:6px"><svg width="14" height="14" style="flex-shrink:0;margin-top:2px"><use href="#sh-i-db"/></svg><div>Passphrase for new backups is generated automatically on first use and stored server-side; also keep a copy offline — without it, encrypted backups cannot be restored. Set <b>VNM_BACKUP_PASSPHRASE</b> to override.</div></div>';
    $('#setUpdate').innerHTML = render(groups.update) + '<div class="sh-note warn" style="margin-top:6px"><svg width="14" height="14" style="flex-shrink:0;margin-top:2px"><use href="#sh-i-alert"/></svg><div>Releases are verified against the built-in project public key (ed25519) unless you provide your own PEM here. Allowing unsigned releases disables a core protection — only for private builds you created yourself.</div></div>';
    $$('[data-test]').forEach((b) => b.onclick = async () => {
      // save current edits first so the test uses them
      await saveSettings(true);
      const r = await guarded(b, () => api('/api/shield/notify/test', { method: 'POST', body: { channel: b.dataset.test } }));
      if (r) toast(r.sent ? 'Test notification sent — check the channel' : 'Channel not configured or failed: ' + JSON.stringify(r.channels || r), r.sent ? '' : 'err');
    });
  }
  async function saveSettings(silent) {
    const body = {};
    $$('.sh-setting').forEach((el) => { body[el.dataset.key] = el.value; });
    const r = await api('/api/shield/settings', { method: 'POST', body });
    if (!silent) { toast(r.ok ? 'Settings saved (' + r.changed + ' keys)' : 'Save failed', r.ok ? '' : 'err'); loadSettings(); }
  }
  $('#btnSaveSettings').onclick = (e) => guarded(e.target.closest('button'), () => saveSettings(false));

  // ---------- global actions ----------
  $('#btnRefresh').onclick = (e) => guarded(e.target.closest('button'), () => loadAll());
  $('#btnDiagnostics').onclick = (e) => confirmModal('Run full diagnostics', '<div style="font-size:13px;color:var(--sh-text-dim);line-height:1.6">Read-only sweep: health checks, integrity scan, all IDS detectors, VM guardian sweep, resource snapshot. Results appear in the respective tabs and anything found opens an incident with a human-readable diagnosis.</div>', 'Run diagnostics', false, async () => {
    const r = await guarded(null, () => api('/api/shield/diagnostics', { method: 'POST' }));
    if (r) {
      const problems = (r.integrity && r.integrity.changes ? r.integrity.changes.length : 0) + (r.vmGuardian && r.vmGuardian.findings ? r.vmGuardian.findings.length : 0);
      toast(problems ? 'Diagnostics finished — ' + problems + ' issue(s) found, see tabs' : 'Diagnostics finished — all clear', problems ? 'err' : '');
      loadAll();
    }
  });
  $('#btnEmergency').onclick = () => confirmModal('ACTIVATE EMERGENCY SHIELD MODE',
    '<div class="sh-note danger"><svg width="15" height="15" style="flex-shrink:0;margin-top:1px"><use href="#sh-i-alert"/></svg><div><b>This is the incident lockdown.</b> All web sessions are revoked (including yours — you will log in again). Risky admin operations (VM/user deletion, settings, restores, updates) are blocked. Evidence is frozen. A recovery code is written for CLI unlock: <span class="sh-tag">sudo scripts/vnmctl emergency off --code &lt;code&gt;</span></div></div>' +
    '<div class="sh-field" style="margin-top:12px"><label>Reason (recorded + notified)</label><input class="sh-input" id="emReason" placeholder="e.g. suspected compromise — investigating"></div>',
    'ACTIVATE LOCKDOWN', true, async () => {
      const r = await guarded(null, () => api('/api/shield/emergency/on', { method: 'POST', body: { reason: ($('#emReason') || {}).value || 'manual' } }));
      if (r) { toast('EMERGENCY MODE ACTIVE — you have been logged out'); setTimeout(() => { window.location.href = '/login'; }, 1500); }
    });

  // ---------- boot ----------
  function loadTab(name) {
    const loaders = { overview: loadOverview, integrity: loadIntegrity, incidents: loadIncidents, security: loadSecurity, recovery: loadRecovery, backups: loadBackups, resources: loadResources, vms: loadVms, updates: loadUpdates, settings: loadSettings };
    if (loaders[name]) loaders[name]();
  }
  async function loadAll() {
    await loadOverview();
    const active = ($$('.sh-tab').find((t) => t.classList.contains('active')) || {}).dataset;
    if (active && active.tab && active.tab !== 'overview') loadTab(active.tab);
  }
  loadAll();
  setInterval(() => loadOverview().catch(() => {}), 60000);
})();
</script>
</body>
</html>
