<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="theme-color" content="#0a0a0f">
  <title><%= title %></title>
  <link rel="icon" href="<%= siteLogo %>" type="image/png">
  <link rel="stylesheet" href="/css/admin.css">
  <link rel="stylesheet" href="/css/vnm-motion.css">
  <link rel="stylesheet" href="/css/vnm-platform.css">
  <style>
    .au-page-icon { width:38px; height:38px; border-radius:11px; background:var(--gradient-primary); border:1px solid var(--border-color); display:flex; align-items:center; justify-content:center; color:var(--text-primary); flex-shrink:0; }
    .act-chip { font-size:10px; font-weight:700; letter-spacing:.4px; padding:2px 8px; border-radius:6px; background:rgba(148,163,184,.1); border:1px solid rgba(148,163,184,.18); color:var(--text-secondary); font-family:'Sarasa Mono SC', ui-monospace, monospace; }
    .result-ok { color:#6ee7b7; font-weight:700; }
    .result-fail { color:#fca5a5; font-weight:700; }
  </style>
</head>
<body>

<svg width="0" height="0" style="position:absolute" aria-hidden="true">
  <defs>
    <symbol id="i-doc" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/></symbol>
    <symbol id="i-refresh" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="23 4 23 10 17 10"/><polyline points="1 20 1 14 7 14"/><path d="M3.51 9a9 9 0 0 1 14.85-3.36L23 10M1 14l4.64 4.36A9 9 0 0 0 20.49 15"/></symbol>
  </defs>
</svg>

<div class="admin-wrapper">
  <%- include('../partials/admin/sidebar') %>

  <div class="admin-main">
    <%- include('../partials/admin/header') %>

    <div class="page-content">
      <div class="page-header">
        <div style="display:flex; align-items:center; gap:14px;">
          <div class="au-page-icon"><svg width="19" height="19"><use href="#i-doc"/></svg></div>
          <div>
            <h1 class="page-title">Audit Log</h1>
            <p style="font-size:13px; color:var(--text-muted); margin-top:4px;">Every security-sensitive action: who, what, from where, and whether it succeeded</p>
          </div>
        </div>
        <div style="display:flex; gap:10px;">
          <button class="mini-btn" onclick="loadAudit()"><svg width="13" height="13"><use href="#i-refresh"/></svg> Refresh</button>
        </div>
      </div>

      <div style="display:flex; gap:10px; margin-bottom:14px; flex-wrap:wrap;">
        <input class="pinput" id="filterAction" placeholder="Filter by action (e.g. login, vm_start…)" style="max-width:260px;" onkeydown="if(event.key==='Enter')loadAudit()">
        <input class="pinput" id="filterUser" placeholder="Filter by username" style="max-width:200px;" onkeydown="if(event.key==='Enter')loadAudit()">
        <button class="mini-btn primary" onclick="loadAudit()">Apply</button>
        <button class="mini-btn" onclick="document.getElementById('filterAction').value='';document.getElementById('filterUser').value='';loadAudit()">Clear</button>
      </div>

      <div class="card" style="padding:18px;">
        <div style="overflow-x:auto;">
          <table class="ptable">
            <thead><tr><th>When</th><th>User</th><th>Action</th><th>Target</th><th>Result</th><th>IP</th><th>Details</th></tr></thead>
            <tbody id="auditBody">
              <tr><td colspan="7"><div class="sk" style="height:36px;"></div></td></tr>
            </tbody>
          </table>
        </div>
        <div style="display:flex; justify-content:center; margin-top:14px;">
          <button class="mini-btn" id="loadMoreBtn" onclick="loadMore()" style="display:none;">Load older entries</button>
        </div>
      </div>
    </div>

    <%- include('../partials/admin/footer') %>
  </div>
</div>

  <script src="/js/vnm-motion.js" defer></script>
  <script src="/js/vnm-platform.js"></script>
  <script>
const fmt = VNM.fmt, esc = VNM.esc;
let oldestId = null;

async function loadAudit(append) {
  const body = document.getElementById('auditBody');
  try {
    const action = document.getElementById('filterAction').value.trim();
    const user = document.getElementById('filterUser').value.trim();
    const params = new URLSearchParams({ limit: '100' });
    if (action) params.set('action', action);
    if (user) params.set('username', user);
    if (append && oldestId) params.set('before', oldestId);
    const res = await fetch('/api/audit?' + params.toString());
    if (!res.ok) { body.innerHTML = '<tr><td colspan="7">Could not load audit log</td></tr>'; return; }
    const rows = await res.json();
    if (!append) body.innerHTML = '';
    if (!rows.length && !append) {
      body.innerHTML = `<tr><td colspan="7"><div class="pempty"><div class="pe-title">No matching entries</div>
        <div class="pe-sub">Logins, VM lifecycle, user management, settings changes, node management, API-key use and more are all recorded here.</div></div></td></tr>`;
    }
    rows.forEach(r => {
      const tr = document.createElement('tr');
      tr.innerHTML = `
        <td style="white-space:nowrap;">${fmt.when(r.created_at)}<div style="font-size:10px;color:var(--text-muted);">${fmt.rel(r.created_at)}</div></td>
        <td style="color:var(--text-primary); font-weight:600;">${esc(r.username || 'system')}</td>
        <td><span class="act-chip">${esc(r.action)}</span></td>
        <td>${r.target_type ? esc(r.target_type) + (r.target_id ? ' #' + esc(r.target_id) : '') : '—'}</td>
        <td class="${r.result === 'success' ? 'result-ok' : 'result-fail'}">${esc(r.result || '—')}</td>
        <td class="mono">${esc(r.ip || '—')}</td>
        <td style="max-width:320px;">${esc(r.details || '—')}</td>`;
      body.appendChild(tr);
      oldestId = r.id;
    });
    document.getElementById('loadMoreBtn').style.display = rows.length >= 100 ? 'inline-flex' : 'none';
  } catch (e) { body.innerHTML = '<tr><td colspan="7">Could not load audit log</td></tr>'; }
}

function loadMore() { loadAudit(true); }

window.addEventListener('load', () => {
  oldestId = null;
  loadAudit(false);
});
</script>
</body>
</html>
