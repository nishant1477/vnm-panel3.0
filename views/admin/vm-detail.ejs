            return `
            <div style="margin-bottom: 8px; padding: 6px 0; border-bottom: 1px solid rgba(255,255,255,0.04); display:flex; align-items:flex-start; gap:8px; flex-wrap:wrap;">
              <span style="color: #64748b; font-size: 11px; display:inline-flex; align-items:center; gap:4px; flex-shrink:0;">${svg('i-clock', 10)} ${new Date(log.timestamp).toLocaleString()}</span>
              <span style="color: ${color}; display:inline-flex; align-items:center; gap:4px; font-weight:600; font-size:11px;">${svg(iconId, 11)} [${log.action?.toUpperCase() || 'LOG'}]</span>
