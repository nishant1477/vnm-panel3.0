    };
    
    el.innerHTML = `
      <div class="terminal-container">
        <div class="terminal-bar">
          <div class="terminal-dot red"></div>
          <div class="terminal-dot yellow"></div>
          <div class="terminal-dot green"></div>
          <span class="terminal-title">vm-${vmId}.log</span>
        </div>
        <div class="terminal-body" style="min-height: 220px; max-height: 380px;">
          ${logs.map(log => {
            const iconId = iconMap[log.action] || 'i-info';
