<div class="admin-wrapper">
  <%- include('../partials/admin/sidebar') %>

  <div class="admin-main">
    <%- include('../partials/admin/header') %>

    <div class="admin-content" id="pageContent">
      <div style="text-align: center; padding: 80px;">
        <div class="spinner spinner-lg" style="margin: 0 auto 16px;"></div>
        <div style="color: var(--text-muted);">Loading VM details...</div>
      </div>
    </div>

    <%- include('../partials/admin/footer') %>
  </div>
</div>

<!-- Snapshot Modal -->
<div class="modal-overlay" id="snapshotModal">
  <div class="modal">
    <div class="modal-header">
      <div class="modal-title" style="display:flex;align-items:center;gap:8px;">
        <span style="color:#8B5CF6;display:inline-flex;"><svg width="18" height="18"><use href="#i-camera"/></svg></span>
        Create Snapshot
      </div>
      <button class="modal-close" onclick="closeModal('snapshotModal')">✕</button>
    </div>
    <div class="modal-body">
      <div class="form-group">
        <label class="form-label">Snapshot Name <span class="required">*</span></label>
        <input type="text" class="form-control" id="snapshotName" placeholder="e.g., before-update-2025">
      </div>
      <div class="form-group">
        <label class="form-label">Description</label>
        <textarea class="form-control" id="snapshotDesc" placeholder="Optional description..." rows="2"></textarea>
      </div>
    </div>
    <div class="modal-footer">
      <button class="btn btn-ghost" onclick="closeModal('snapshotModal')">Cancel</button>
      <button class="btn btn-primary" onclick="createSnapshot()">
        <svg width="14" height="14" style="margin-right:6px;"><use href="#i-camera"/></svg>
        Create Snapshot
      </button>
    </div>
  </div>
</div>

<!-- Reinstall Modal -->
<div class="modal-overlay" id="reinstallModal">
  <div class="modal">
    <div class="modal-header">
      <div class="modal-title" style="display:flex;align-items:center;gap:8px;">
        <span style="color:#F59E0B;display:inline-flex;"><svg width="18" height="18"><use href="#i-refresh"/></svg></span>
        Reinstall VM
      </div>
      <button class="modal-close" onclick="closeModal('reinstallModal')">✕</button>
    </div>
    <div class="modal-body">
      <div class="alert alert-warning" style="margin-bottom: 16px;">
        <span class="alert-icon" style="color:#F59E0B;display:inline-flex;"><svg width="16" height="16"><use href="#i-alert"/></svg></span>
        <span><strong>Warning!</strong> This will delete the VM disk and cloud-init seed. Logs will be kept for audit trail.</span>
      </div>
      
      <form id="reinstallForm" onsubmit="performReinstall(event)">
        <div class="form-group">
          <label class="form-label" style="font-weight: 600;">Select OS Template <span class="required">*</span></label>
          <select class="form-control" name="new_os_template" id="reinstall_template" required style="margin-bottom: 12px;">
            <option value="">— Choose Template —</option>
          </select>
          <div class="form-hint" style="color: var(--text-muted);">Select a new OS to reinstall. Keep current or choose different.</div>
        </div>
        
        <div class="form-group">
          <label class="form-label" style="font-weight: 600;">New Username (Optional)</label>
          <input type="text" class="form-control" name="new_username" id="reinstall_username" placeholder="Leave blank to keep current">
          <div class="form-hint">Default user for cloud-init templates (ubuntu, debian, root, etc.)</div>
        </div>
        
        <div class="form-group">
          <label class="form-label" style="font-weight: 600;">New Password (Optional)</label>
          <input type="password" class="form-control" name="new_password" id="reinstall_password" placeholder="Leave blank to keep current">
          <div class="form-hint">SSH password for the new installation</div>
        </div>
        
        <label class="toggle-switch" style="margin: 16px 0;">
          <input type="checkbox" class="toggle-input" name="confirm" id="reinstall_confirm" required>
          <div class="toggle-track"><div class="toggle-thumb"></div></div>
          <div>
            <div class="toggle-label" style="font-size: 13px; color: var(--text-primary);">I understand this will delete all VM data</div>
          </div>
        </label>
      </form>
    </div>
    <div class="modal-footer">
      <button class="btn btn-ghost" onclick="closeModal('reinstallModal')">Cancel</button>
      <button class="btn btn-danger" id="confirmReinstallBtn" onclick="document.getElementById('reinstallForm').dispatchEvent(new Event('submit'))">
        <svg width="14" height="14" style="margin-right:6px;"><use href="#i-refresh"/></svg>
        Reinstall
      </button>
    </div>
  </div>
</div>

<!-- ISO Attach Modal -->
<div class="modal-overlay" id="isoAttachModal">
  <div class="modal">
    <div class="modal-header">
      <div class="modal-title" style="display:flex;align-items:center;gap:8px;">
        <span style="color:#06B6D4;display:inline-flex;"><svg width="18" height="18"><use href="#i-disc"/></svg></span>
        Attach ISO to VM
      </div>
      <button class="modal-close" onclick="closeModal('isoAttachModal')">✕</button>
    </div>
    <div class="modal-body">
      <div class="alert alert-info" style="margin-bottom: 16px;">
        <span class="alert-icon" style="color:#3B82F6;display:inline-flex;"><svg width="16" height="16"><use href="#i-info"/></svg></span>
        <span><strong>ISO Boot:</strong> VM will boot from this ISO. After OS installation completes, detach the ISO to boot from disk.</span>
      </div>
      
      <div class="form-group">
        <label class="form-label" style="font-weight: 600;">Select ISO File <span class="required">*</span></label>
        <select class="form-control" id="isoFileSelect" required>
          <option value="">— Loading ISO files... —</option>
        </select>
        <div class="form-hint" style="color: var(--text-muted); margin-top: 8px;">
          Choose an ISO file to attach. Upload new ISOs to <code>/home/user/vms/iso/</code>
        </div>
      </div>
      
      <div class="alert alert-warning" style="margin-top: 16px;">
        <span class="alert-icon" style="color:#F59E0B;display:inline-flex;"><svg width="16" height="16"><use href="#i-alert"/></svg></span>
        <span><strong>Note:</strong> You may need to restart the VM to boot from the attached ISO.</span>
      </div>
    </div>
    <div class="modal-footer">
      <button class="btn btn-ghost" onclick="closeModal('isoAttachModal')">Cancel</button>
      <button class="btn btn-primary" onclick="performISOAttach()">
        <svg width="14" height="14" style="margin-right:6px;"><use href="#i-attach"/></svg>
        Attach ISO
      </button>
    </div>
  </div>
</div>

<div class="modal-overlay" id="migrateModal">
  <div class="modal" style="max-width:520px;">
    <div class="modal-header">
      <div class="modal-title" style="display:flex;align-items:center;gap:8px;">
        <span style="color:#22d3ee;display:inline-flex;"><svg width="18" height="18"><use href="#i-globe"/></svg></span>
        Live Migration <span class="prem-feature-chip" id="migrateChip" style="margin-left:6px">Premium</span>
      </div>
      <button class="modal-close" onclick="closeModal('migrateModal')">✕</button>
    </div>
    <div class="modal-body">
      <div class="alert alert-info" style="margin-bottom:14px;">
        <span class="alert-icon" style="color:#3B82F6;display:inline-flex;"><svg width="16" height="16"><use href="#i-info"/></svg></span>
        <span><strong>How it works:</strong> the VM is stopped, its disk is copied to the target node, then it is restarted there (if it was running). Live progress appears in Task Automation.</span>
      </div>
      <div id="migrateTargets" style="display:flex;flex-direction:column;gap:10px;"><div class="sk" style="height:58px;"></div></div>
    </div>
    <div class="modal-footer">
      <button class="btn btn-ghost" onclick="closeModal('migrateModal')">Cancel</button>
    </div>
  </div>
</div>

<script>
const vmId = <%= vmId %>;
let vmData = null;
let statsInterval = null;

// SVG helper for dynamic contexts
function svg(id, size = 14) {
  return `<svg width="${size}" height="${size}"><use href="#${id}"/></svg>`;
}

async function loadVM() {
  try {
    const [vmRes, statsRes] = await Promise.all([
      fetch(`/api/vms/${vmId}`),
      fetch(`/api/vms/${vmId}/stats`).catch(() => null)
    ]);

    if (!vmRes.ok) throw new Error('VM not found');
    vmData = await vmRes.json();
    const stats = statsRes && statsRes.ok ? await statsRes.json() : null;
    
    renderPage(vmData, stats);
    setTimeout(() => loadISOStatus(), 400);
  } catch(e) {
    document.getElementById('pageContent').innerHTML = `
      <div class="empty-state">
        <div class="empty-state-icon" style="color:#EF4444;">${svg('i-alert', 48)}</div>
        <div class="empty-state-title">VM Not Found</div>
        <div class="empty-state-desc">${escHtml(e.message)}</div>
        <a href="/admin/vms" class="btn btn-primary">${svg('i-back', 13)} Back to VMs</a>
      </div>`;
  }
}

function renderPage(vm, stats) {
  const statusCls = vm.status === 'running' ? 'badge-running' : vm.status === 'error' ? 'badge-error' : 'badge-stopped';
  const isRunning = vm.status === 'running';
  const icon = vm.template_icon;
  const displayIcon = (icon && icon.startsWith('http') || icon.startsWith('/')) ? icon : '/images/os/generic.svg';
  
  document.getElementById('pageContent').innerHTML = `
    <!-- Page Header -->
    <div class="page-header" style="align-items:center;">
      <div style="display: flex; align-items: center; gap: 14px; flex: 1; min-width: 0;">
        <a href="/admin/vms" style="color: var(--text-muted); text-decoration: none; display: inline-flex; align-items: center; gap: 4px; font-size: 13px; flex-shrink: 0;">
          ${svg('i-back', 14)}
          Back
        </a>
        <div style="min-width: 0; flex: 1; display: flex; align-items: center; gap: 12px;">
          <img src="${displayIcon}" alt="OS" style="width: 40px; height: 40px; object-fit: contain; border-radius: 10px; padding:6px; background:linear-gradient(135deg,rgba(99,102,241,0.12),rgba(139,92,246,0.06)); border:1px solid rgba(99,102,241,0.2);" onerror="this.src='/images/os/generic.svg';">
          <div style="min-width: 0; flex: 1;">
            <h1 class="page-title" style="white-space: nowrap; overflow: hidden; text-overflow: ellipsis; margin:0;">
              ${escHtml(vm.vm_name)}
            </h1>
            <p style="font-size: 12px; color: var(--text-muted); margin-top: 3px; display:flex; align-items:center; gap:8px; flex-wrap:wrap;">
              <span style="background:rgba(99,102,241,0.1); color:#6366F1; padding:2px 8px; border-radius:5px; font-family:monospace; font-weight:600;">#${vm.vm_id}</span>
              <span>${escHtml(vm.template_name || vm.os_type || 'Custom OS')}</span>
              <span style="opacity:0.6;">·</span>
              <span style="display:inline-flex;align-items:center;gap:4px;">${svg('i-server', 11)} ${vm.node_name || 'localhost'}</span>
            </p>
          </div>
        </div>
      </div>
      <div class="page-actions" style="align-items:center;">
        <span class="badge ${statusCls}" style="padding: 5px 12px; font-size: 12px;">
          <span class="dot"></span> ${vm.status.toUpperCase()}
        </span>
        ${isRunning
          ? `<button class="btn btn-warning btn-sm" onclick="doAction('stop')">${svg('i-stop', 12)} Stop</button>
             <button class="btn btn-ghost btn-sm" onclick="doAction('restart')">${svg('i-restart', 12)} Restart</button>`
          : `<button class="btn btn-success btn-sm" onclick="doAction('start')">${svg('i-play', 12)} Start</button>`
        }
        <a href="/admin/vm/${vmId}/console" class="btn btn-outline btn-sm">${svg('i-terminal', 13)} Console</a>
        <a href="/admin/vm/${vmId}/ssh" class="btn btn-outline btn-sm" title="SSH Terminal">${svg('i-ssh', 13)} SSH</a>
        <a href="/admin/vm/${vmId}/files" class="btn btn-outline btn-sm" title="File Manager">${svg('i-folder', 13)} Files</a>
        <a href="/admin/vm/${vmId}/rdp" class="btn btn-outline btn-sm" title="Remote Desktop (RDP)">${svg('i-server', 13)} RDP</a>
        <a href="/admin/vm/${vmId}/edit" class="btn btn-ghost btn-sm">${svg('i-edit', 13)} Edit</a>
      </div>
    </div>

    <!-- Stats Row -->
    <div class="stats-grid" style="margin-bottom: 20px;">
      <div class="stat-card" style="--card-gradient: var(--gradient-primary); padding: 16px;">
        <div style="display:flex; justify-content:space-between; align-items:flex-start; margin-bottom:10px;">
          <div style="width:38px; height:38px; border-radius:10px; background:rgba(236,72,153,0.12); color:#EC4899; display:flex; align-items:center; justify-content:center;">${svg('i-cpu', 20)}</div>
        </div>
        <div style="font-size: 24px; font-weight: 800; color: var(--text-primary);">${vm.cpus || '—'}</div>
        <div style="font-size: 11px; color: var(--text-muted); text-transform: uppercase; letter-spacing:0.5px;">vCPUs</div>
        <div style="font-size: 10px; color: var(--text-muted); margin-top: 6px;">${vm.cpu_sockets || 1}S × ${vm.cpu_cores || 1}C × ${vm.cpu_threads || 1}T</div>
      </div>
      <div class="stat-card" style="--card-gradient: var(--gradient-blue); padding: 16px;">
        <div style="width:38px; height:38px; border-radius:10px; background:rgba(16,185,129,0.12); color:#10B981; display:flex; align-items:center; justify-content:center; margin-bottom:10px;">${svg('i-mem', 20)}</div>
        <div style="font-size: 24px; font-weight: 800; color: var(--text-primary);">${formatBytes(vm.memory)}</div>
        <div style="font-size: 11px; color: var(--text-muted); text-transform: uppercase; letter-spacing:0.5px;">RAM</div>
        <div style="font-size: 10px; color: var(--text-muted); margin-top: 6px;">${vm.memory}MB total</div>
      </div>
      <div class="stat-card" style="--card-gradient: var(--gradient-orange); padding: 16px;">
        <div style="width:38px; height:38px; border-radius:10px; background:rgba(6,182,212,0.12); color:#06B6D4; display:flex; align-items:center; justify-content:center; margin-bottom:10px;">${svg('i-disc', 20)}</div>
        <div style="font-size: 24px; font-weight: 800; color: var(--text-primary);">${vm.disk_size || '—'}</div>
        <div style="font-size: 11px; color: var(--text-muted); text-transform: uppercase; letter-spacing:0.5px;">Storage</div>
        <div style="font-size: 10px; color: var(--text-muted); margin-top: 6px;">qcow2 format</div>
      </div>
      <div class="stat-card" style="--card-gradient: var(--gradient-green); padding: 16px;">
        <div style="width:38px; height:38px; border-radius:10px; background:rgba(59,130,246,0.12); color:#3B82F6; display:flex; align-items:center; justify-content:center; margin-bottom:10px;">${svg('i-globe', 20)}</div>
        <div style="font-size: 16px; font-weight: 700; color: var(--text-primary); word-break: break-all;">${vm.ipv4_address || (vm.network_type === 'nat' ? 'DHCP (Auto)' : '—')}</div>
        <div style="font-size: 11px; color: var(--text-muted); text-transform: uppercase; letter-spacing:0.5px;">IPv4</div>
        <div style="font-size: 10px; color: var(--text-muted); margin-top: 6px;">SSH: ${vm.ssh_port || vm.ssh_port_static || '22'}</div>
      </div>
    </div>

    <!-- Detail Tabs -->
    <div class="card">
      <div class="card-header" style="padding-bottom: 0; border-bottom: none;">
        <div class="tabs" style="margin-bottom: 0; border-bottom: 1px solid var(--border-subtle); width: 100%;">
          <button class="tab-btn active" onclick="switchTab('overview')" data-tab="overview">${svg('i-list', 13)} Overview</button>
          <button class="tab-btn" onclick="switchTab('network')" data-tab="network">${svg('i-globe', 13)} Network</button>
          <button class="tab-btn" onclick="switchTab('rdp')" data-tab="rdp">${svg('i-server', 13)} RDP</button>
          <button class="tab-btn" onclick="switchTab('hardware')" data-tab="hardware">${svg('i-cpu', 13)} Hardware</button>
          <button class="tab-btn" onclick="switchTab('snapshots')" data-tab="snapshots">${svg('i-camera', 13)} Snapshots &amp; Backups</button>
          <button class="tab-btn" onclick="switchTab('logs')" data-tab="logs">${svg('i-scroll', 13)} Logs</button>
        </div>
      </div>
      <div class="card-body">

        <!-- Overview Tab -->
        <div class="tab-pane active" id="tab-overview">
          <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 24px;">
            <div>
              <div style="font-size: 11px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.8px; color: #6366F1; margin-bottom: 12px; display:inline-flex; align-items:center; gap:6px;">${svg('i-server', 12)} System Information</div>
              ${renderInfoRow('VM Name', vm.vm_name)}
              ${renderInfoRow('VM ID', `#${vm.vm_id}`)}
              ${renderInfoRow('Operating System', vm.os_type || 'Custom OS')}
              ${renderInfoRow('Template Type', vm.template_type || '—')}
              ${renderInfoRow('Hostname', vm.hostname || '—')}
              ${renderInfoRow('Node', vm.node_name || 'localhost')}
              ${renderInfoRow('Created', vm.created_at ? new Date(vm.created_at).toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric', hour: '2-digit', minute: '2-digit' }) : '—')}
            </div>
            <div>
              <div style="font-size: 11px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.8px; color: #10B981; margin-bottom: 12px; display:inline-flex; align-items:center; gap:6px;">${svg('i-shield', 12)} Access Information</div>
              ${renderInfoRow('Username', vm.username || '—', false, true)}
              ${renderInfoRow('SSH Port', vm.ssh_port || vm.ssh_port_static || '22')}
              ${renderInfoRow('NIC Model', vm.nic_model || 'virtio-net-pci')}
              ${renderInfoRow('Network Type', vm.network_type === 'nat' ? 'NAT (User Mode)' : (vm.network_type === 'static_public' ? 'Static Public IPv4' : vm.network_type))}
              ${renderInfoRow('MAC Address', vm.mac_address || '—', true)}
              ${renderInfoRow('KVM Enabled', vm.enable_kvm ? renderStatusIcon(true, 'Yes') : renderStatusIcon(false, 'No'))}
              ${renderInfoRow('ACPI Enabled', vm.enable_acpi ? renderStatusIcon(true, 'Yes') : renderStatusIcon(false, 'No'))}
            </div>
          </div>
          
          ${vm.ssh_port || vm.ssh_port_static ? `
          <div style="margin-top: 20px; padding: 16px; background: linear-gradient(135deg, rgba(99, 102, 241, 0.08), rgba(139,92,246,0.03)); border: 1px solid rgba(99, 102, 241, 0.2); border-radius: var(--radius-md);">
            <div style="font-size: 11px; color: var(--text-muted); margin-bottom: 10px; text-transform: uppercase; letter-spacing: 0.8px; display:inline-flex; align-items:center; gap:6px;">
              <span style="color:#6366F1;">${svg('i-terminal', 12)}</span> Quick SSH Connect
            </div>
            <div class="code-block" style="display: flex; align-items: center; justify-content: space-between; gap: 10px; padding: 12px 14px; font-family: monospace;">
              <span id="sshCmd">ssh ${escHtml(vm.username || 'root')}@${escHtml(vm.node_mode === 'remote' && vm.node_address ? vm.node_address : 'localhost')} -p ${vm.ssh_port || vm.ssh_port_static || 22}</span>
              <button class="btn btn-ghost btn-sm" onclick="copySSH()">${svg('i-copy', 12)} Copy</button>
            </div>
          </div>
          ` : ''}
          
          ${(Array.isArray(vm.port_forwards) && vm.port_forwards.length) ? `
          <div style="margin-top: 16px; padding: 16px; background: rgba(6, 182, 212, 0.05); border: 1px solid rgba(6, 182, 212, 0.2); border-radius: var(--radius-md);">
            <div style="font-size: 11px; color: var(--text-muted); margin-bottom: 10px; text-transform: uppercase; letter-spacing: 0.8px; display:inline-flex; align-items:center; gap:6px;">
              <span style="color:#06B6D4;">${svg('i-network', 12)}</span> Port Forwards
            </div>
            <div style="display:grid; gap:6px;">
              ${vm.port_forwards.map(pf => `
              <div style="display:flex; align-items:center; justify-content:space-between; gap:10px; padding:8px 12px; background: rgba(6,182,212,0.06); border-radius: 8px; font-size: 12.5px; flex-wrap: wrap;">
                <span style="font-weight:600;">${escHtml(pf.label || (pf.protocol.toUpperCase() + ' ' + pf.host_port))}</span>
                <span style="font-family: monospace; color: var(--text-muted);">${escHtml(pf.protocol.toUpperCase())} ${escHtml(vm.node_mode === 'remote' && vm.node_address ? vm.node_address : 'localhost')}:${pf.host_port} → :${pf.guest_port}</span>
              </div>`).join('')}
            </div>
          </div>
          ` : ''}

          <!-- ISO Management Section -->
          <div id="isoManagementSection" style="margin-top: 20px; padding: 16px; background: rgba(6, 182, 212, 0.05); border: 1px solid rgba(6, 182, 212, 0.2); border-radius: var(--radius-md); display: none;">
            <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 12px; gap:12px; flex-wrap:wrap;">
              <div style="display:flex; align-items:center; gap:12px; flex:1; min-width:0;">
                <div style="width:38px; height:38px; border-radius:10px; background:rgba(6,182,212,0.15); color:#06B6D4; display:flex; align-items:center; justify-content:center; flex-shrink:0;">${svg('i-disc', 20)}</div>
                <div style="min-width:0;">
                  <div style="font-size: 11px; color: var(--text-muted); text-transform: uppercase; letter-spacing: 0.8px; margin-bottom: 2px;">ISO Management</div>
                  <div style="font-size: 13px; font-weight: 600; color: var(--text-primary);" id="isoStatus">Loading...</div>
                </div>
              </div>
              <div style="display: flex; gap: 8px;">
                <button class="btn btn-primary btn-sm" onclick="openISOAttachModal()" id="attachISOBtn" style="display: none;">${svg('i-attach', 12)} Attach ISO</button>
                <button class="btn btn-ghost btn-sm" onclick="detachISO()" id="detachISOBtn" style="display: none;">${svg('i-unlink', 12)} Detach ISO</button>
              </div>
            </div>
            <div id="isoInfo" style="font-size: 12px; color: var(--text-muted);"></div>
          </div>
        </div>

        <!-- Network Tab -->
        <div class="tab-pane" id="tab-network">
          <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 24px;">
            <div>
              <div style="font-size: 11px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.8px; color: #3B82F6; margin-bottom: 12px; display:inline-flex; align-items:center; gap:6px;">${svg('i-globe', 12)} Network Configuration</div>
              ${renderInfoRow('Network Type', vm.network_type === 'nat' ? 'NAT (User Mode)' : (vm.network_type === 'static_public' ? 'Static Public IPv4' : vm.network_type))}
              ${renderInfoRow('IPv4 Address', vm.ipv4_address || (vm.network_type === 'nat' ? 'DHCP (Auto)' : '—'))}
              ${renderInfoRow('Gateway', vm.gateway || '—')}
              ${renderInfoRow('Netmask', vm.netmask || '/24')}
              ${renderInfoRow('DNS Servers', vm.dns_servers || '8.8.8.8, 8.8.4.4')}
            </div>
            <div>
              <div style="font-size: 11px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.8px; color: #06B6D4; margin-bottom: 12px; display:inline-flex; align-items:center; gap:6px;">${svg('i-network', 12)} Network Details</div>
              ${renderInfoRow('MAC Address', vm.mac_address || '—', true)}
              ${renderInfoRow('VLAN ID', vm.vlan_id || 'None')}
              ${renderInfoRow('Bridge Device', vm.bridge_device || vm.bridge_interface || '—')}
              ${renderInfoRow('SSH Port', vm.ssh_port || vm.ssh_port_static || '22')}
              ${renderInfoRow('NIC Model', vm.nic_model || 'virtio-net-pci')}
            </div>
          </div>
        </div>

        <!-- RDP Tab -->
        <div class="tab-pane" id="tab-rdp">
          <div id="rdpPanel"><div style="text-align:center; padding:20px;"><div class="spinner" style="margin:0 auto;"></div></div></div>
        </div>

        <!-- Hardware Tab -->
        <div class="tab-pane" id="tab-hardware">
          <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 24px;">
            <div>
              <div style="font-size: 11px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.8px; color: #EC4899; margin-bottom: 12px; display:inline-flex; align-items:center; gap:6px;">${svg('i-cpu', 12)} CPU Configuration</div>
              ${renderInfoRow('CPU Model', vm.cpu_model || 'host')}
              ${renderInfoRow('Custom CPU', vm.custom_cpu_name || '—')}
              ${renderInfoRow('Sockets', vm.cpu_sockets || '1')}
              ${renderInfoRow('Cores', vm.cpu_cores || '2')}
              ${renderInfoRow('Threads', vm.cpu_threads || '1')}
              ${renderInfoRow('Total vCPUs', vm.cpus || '—')}
              ${renderInfoRow('Machine Type', vm.machine_type || 'pc')}
            </div>
            <div>
              <div style="font-size: 11px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.8px; color: #F59E0B; margin-bottom: 12px; display:inline-flex; align-items:center; gap:6px;">${svg('i-wrench', 12)} SMBIOS / Identity</div>
              ${renderInfoRow('Manufacturer', vm.smbios_manufacturer || 'QEMU')}
              ${renderInfoRow('Product', vm.smbios_product || '—')}
              ${renderInfoRow('Version', vm.smbios_version || '1.0')}
              ${renderInfoRow('Serial', vm.smbios_serial || '—', true)}
              ${renderInfoRow('Board Name', vm.board_name || '—')}
              ${renderInfoRow('Product Name', vm.product_name || '—')}
            </div>
          </div>
          ${vm.extra_args ? `
          <div style="margin-top: 20px;">
            <div style="font-size: 11px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.8px; color: var(--text-muted); margin-bottom: 8px; display:inline-flex; align-items:center; gap:6px;">${svg('i-terminal', 12)} Extra QEMU Arguments</div>
            <div class="code-block">${escHtml(vm.extra_args)}</div>
          </div>` : ''}
        </div>

        <!-- Snapshots Tab -->
        <div class="tab-pane" id="tab-snapshots">
          <div style="display: flex; justify-content: space-between; align-items:center; margin-bottom: 16px;">
            <div style="font-size: 13px; color: var(--text-muted);">Manage VM snapshots for backup and recovery</div>
            <button class="btn btn-primary btn-sm" onclick="openModal('snapshotModal')" ${!isRunning ? '' : 'disabled title="Snapshots capture the disk at rest - stop the VM first"'}>
              ${svg('i-camera', 12)} New Snapshot
            </button>
          </div>
          <div id="snapshotsList">
            <div style="text-align: center; padding: 20px;"><div class="spinner" style="margin: 0 auto;"></div></div>
          </div>

          <div style="display: flex; justify-content: space-between; align-items:center; margin: 22px 0 12px; padding-top: 16px; border-top: 1px solid var(--border-subtle);">
            <div>
              <div style="font-size: 13.5px; font-weight: 700; color: var(--text-primary);">Full File Backups</div>
              <div style="font-size: 12px; color: var(--text-muted); margin-top: 2px;">Exported qcow2 images with SHA-256 integrity checks, restorable here or into a test clone</div>
            </div>
            <button class="mini-btn primary" onclick="createBackupNow()" ${!isRunning ? '' : 'disabled title="Stop the VM first - backups capture the disk at rest"'}>
              ${svg('i-camera', 11)} Back up now
            </button>
          </div>
          <div id="backupsList" style="display:grid; gap:10px;">
            <div style="text-align:center; padding:16px;"><div class="spinner" style="margin: 0 auto;"></div></div>
          </div>

        </div>

        <!-- Logs Tab -->
        <div class="tab-pane" id="tab-logs">
          <div id="logsList">
            <div style="text-align: center; padding: 20px;"><div class="spinner" style="margin: 0 auto;"></div></div>
          </div>
        </div>

      </div>
    </div>

    <!-- Platform Actions (Round 5) -->
    <div class="card" style="margin-top: 20px;">
      <div class="card-header">
        <div class="card-title" style="display:flex; align-items:center; gap:8px;">
          <span style="color:#22d3ee;display:inline-flex;">${svg('i-rocket', 16)}</span>
          Platform Actions
        </div>
      </div>
      <div class="card-body">
        <div style="display: grid; grid-template-columns: 1fr auto; gap: 16px; align-items: center; padding: 14px 0; border-bottom: 1px solid var(--border-subtle);">
          <div>
            <div style="font-size: 13px; font-weight: 600; color: var(--text-primary); display:inline-flex; align-items:center; gap:6px;">
              <span style="color:#818cf8;">${svg('i-copy', 14)}</span> Clone VM
            </div>
            <div style="font-size: 12px; color: var(--text-muted); margin-top: 3px;">Full copy of this VM (disk + cloud-init) as a new VM. Requires the VM to be stopped.</div>
          </div>
          <button class="mini-btn" onclick="cloneVmNow()" ${!isRunning ? '' : 'disabled title="Stop the VM first"'}>${svg('i-copy', 12)} Clone</button>
        </div>
        <div style="display: grid; grid-template-columns: 1fr auto; gap: 16px; align-items: center; padding: 14px 0; border-bottom: 1px solid var(--border-subtle);">
          <div>
            <div style="font-size: 13px; font-weight: 600; color: var(--text-primary); display:inline-flex; align-items:center; gap:6px;">
              <span style="color:#c084fc;">${svg('i-globe', 14)}</span> Migrate to another node
            </div>
            <div style="font-size: 12px; color: var(--text-muted); margin-top: 3px;">Move this VM disk to a different node over the agent relay, with checksum verification at both ends.</div>
          </div>
          <button class="mini-btn" onclick="openMigrateModal()">${svg('i-globe', 12)} Migrate…</button>
        </div>
        <div style="display: grid; grid-template-columns: 1fr auto; gap: 16px; align-items: center; padding: 14px 0;">
          <div>
            <div style="font-size: 13px; font-weight: 600; color: var(--text-primary); display:inline-flex; align-items:center; gap:6px;">
              <span style="color:#f59e0b;">${svg('i-hash', 14)}</span> Tags, Group &amp; Notes
            </div>
            <div style="font-size: 12px; color: var(--text-muted); margin-top: 3px;">Organize your fleet - tags are searchable from the command palette (Ctrl+K).</div>
            <div style="margin-top:10px;">
              <div style="display:flex; gap:8px; flex-wrap:wrap; margin-bottom:8px;">
                <input class="pinput" id="metaTags" placeholder="tags, comma separated" style="max-width:280px;">
                <input class="pinput" id="metaGroup" placeholder="group (e.g. production)" style="max-width:180px;">
              </div>
              <textarea class="pinput" id="metaNotes" placeholder="Notes about this VM…" rows="2" style="resize:vertical;"></textarea>
            </div>
          </div>
          <button class="mini-btn primary" onclick="saveMeta()">${svg('i-check', 12)} Save</button>
        </div>
      </div>
    </div>

    <!-- Danger Zone -->
    <div class="card" style="margin-top: 20px; border-color: rgba(239, 68, 68, 0.25);">
      <div class="card-header">
        <div class="card-title" style="color: var(--accent-red); display:flex; align-items:center; gap:8px;">
          <span style="color:#EF4444;display:inline-flex;">${svg('i-alert', 18)}</span>
          Danger Zone
        </div>
      </div>
      <div class="card-body">
        <div style="display: grid; grid-template-columns: 1fr auto; gap: 16px; align-items: center; padding: 14px 0; border-bottom: 1px solid var(--border-subtle);">
          <div>
            <div style="font-size: 13px; font-weight: 600; color: var(--text-primary); display:inline-flex; align-items:center; gap:6px;">
              <span style="color:#F59E0B;">${svg('i-wrench', 14)}</span> Reinstall VM
            </div>
            <div style="font-size: 12px; color: var(--text-muted); margin-top: 3px;">Wipe disk and reinstall from template. Stops VM first.</div>
          </div>
          <button class="btn btn-warning btn-sm" onclick="doAction('reinstall')">${svg('i-refresh', 12)} Reinstall</button>
        </div>
        <div style="display: grid; grid-template-columns: 1fr auto; gap: 16px; align-items: center; padding: 14px 0;">
          <div>
            <div style="font-size: 13px; font-weight: 600; color: var(--accent-red); display:inline-flex; align-items:center; gap:6px;">
              <span>${svg('i-trash', 14)}</span> Delete VM
            </div>
            <div style="font-size: 12px; color: var(--text-muted); margin-top: 3px;">Permanently delete this VM and all associated files.</div>
          </div>
          <button class="btn btn-danger btn-sm" onclick="deleteVM()">${svg('i-trash', 12)} Delete</button>
        </div>
      </div>
    </div>
  `;

  loadSnapshots();
  loadLogs();
  loadRdp();
  // Round 5 fix: the platform tabs refresh here too - renderPage replaces
  // the whole DOM, so anything captured before it went stale.
  loadBackups();
  loadMeta();
  if (location.hash === '#rdp') switchTab('rdp'); // deep link from the VM lists
}

// ============= RDP (xrdp inside Debian/Ubuntu guests) =============
let rdpTimer = null;
let rdpLast = null;

function rdpBadge(status) {
  const map = {
    online:          ['ONLINE', '#10B981', 'rgba(16,185,129,0.12)'],
    offline:         ['OFFLINE', '#94A3B8', 'rgba(148,163,184,0.14)'],
    installing:      ['INSTALLING', '#6366F1', 'rgba(99,102,241,0.12)'],
    pending_restart: ['RESTART REQUIRED', '#F59E0B', 'rgba(245,158,11,0.14)'],
    unsupported:     ['UNSUPPORTED OS', '#EF4444', 'rgba(239,68,68,0.12)'],
    error:           ['ERROR', '#EF4444', 'rgba(239,68,68,0.12)'],
    disabled:        ['DISABLED', '#94A3B8', 'rgba(148,163,184,0.14)']
  };
  const m = map[status] || map.disabled;
  return `<span style="display:inline-flex;align-items:center;gap:6px;padding:4px 10px;border-radius:999px;font-size:11px;font-weight:700;letter-spacing:0.5px;color:${m[1]};background:${m[2]};">
    <span style="width:7px;height:7px;border-radius:50%;background:${m[1]};"></span>${m[0]}</span>`;
}

function renderRdp(d) {
  const el = document.getElementById('rdpPanel');
  if (!el) return;
  const direct = d.network === 'direct';
  const running = d.vm_status === 'running';
  const busy = d.status === 'installing';
  const connect = d.enabled && d.port && d.host ? `${d.host}:${d.port}` : null;

  let actions = '';
  if (!d.enabled || d.status === 'error' || d.status === 'unsupported') {
    actions += `<button class="btn btn-primary btn-sm" onclick="enableRdp()" ${(!running || busy) ? 'disabled' : ''}
      title="${!running ? 'Start the VM first' : ''}">${svg('i-power', 12)} ${busy ? 'Working…' : 'Enable RDP'}</button>`;
  } else {
    actions += `<button class="btn btn-ghost btn-sm" onclick="enableRdp()" ${(!running || busy) ? 'disabled' : ''} title="Re-run the (safe, repeatable) xrdp setup inside the VM">${svg('i-refresh', 12)} Re-run setup</button>
                <button class="btn btn-warning btn-sm" onclick="disableRdp()" ${busy ? 'disabled' : ''}>${svg('i-unlink', 12)} Disable RDP</button>`;
  }

  let note = '';
  if (d.message && d.status !== 'online' && d.status !== 'disabled') {
    const bad = d.status === 'error' || d.status === 'unsupported';
    note = `<div style="margin-top:14px;padding:10px 12px;border-radius:8px;font-size:12px;
        color:${bad ? '#EF4444' : 'var(--text-secondary)'};background:${bad ? 'rgba(239,68,68,0.08)' : 'rgba(148,163,184,0.10)'};">
        ${busy ? '<span class="spinner" style="display:inline-block;width:12px;height:12px;vertical-align:-2px;margin-right:6px;"></span>' : ''}${escHtml(d.message)}</div>`;
  } else if (d.status === 'disabled') {
    note = `<div style="margin-top:14px;font-size:12px;color:var(--text-muted);">Installs xrdp and a desktop inside the VM (Debian/Ubuntu only) ${direct ? 'and uses the VM\'s own address on port 3389' : 'and forwards a dedicated host port to it'}. The VM must be running.</div>`;
  }
  const warn = d.warning ? `<div style="margin-top:14px;padding:10px 12px;border-radius:8px;font-size:12px;color:#F59E0B;background:rgba(245,158,11,0.10);">⚠ ${escHtml(d.warning)}</div>` : '';

  el.innerHTML = `
    <div style="display:flex;justify-content:space-between;align-items:center;gap:12px;flex-wrap:wrap;margin-bottom:14px;">
      <div style="display:flex;align-items:center;gap:10px;">
        <div style="font-size:13px;font-weight:600;color:var(--text-primary);">Remote Desktop (RDP)</div>
        ${rdpBadge(d.status)}
      </div>
      <div style="display:flex;gap:8px;">${actions}</div>
    </div>
    <div style="margin-bottom:14px;font-size:12px;"><a href="/admin/vm/${vmId}/rdp" style="color:#818cf8;text-decoration:none;">Open the full RDP page →</a> <span style="color:var(--text-muted);">(setup progress, .rdp file, connect guides)</span></div>
    ${d.enabled ? `
    <div style="display:grid;grid-template-columns:1fr 1fr;gap:24px;">
      <div>
        ${renderInfoRow('RDP Host', d.host || '—', true)}
        ${renderInfoRow('RDP Port', d.port || '—', true)}
        ${renderInfoRow('Username', d.username || '—', false, true)}
      </div>
      <div>
        ${renderInfoRow('Guest OS', d.guest_os || '—')}
        ${renderInfoRow('Set up', d.installed_at ? new Date(d.installed_at.replace(' ', 'T') + 'Z').toLocaleString() : '—')}
        ${renderInfoRow('Network', direct ? 'Direct address' : 'NAT (port forward)')}
      </div>
    </div>
    <div style="margin-top:16px;padding:14px;border:1px solid rgba(99,102,241,0.2);border-radius:var(--radius-md);background:rgba(99,102,241,0.05);">
      <div style="font-size:11px;color:var(--text-muted);text-transform:uppercase;letter-spacing:0.8px;margin-bottom:8px;">Connection address — use any RDP client (Windows Remote Desktop, Remmina)</div>
      <div class="code-block" style="display:flex;align-items:center;justify-content:space-between;gap:10px;padding:12px 14px;font-family:monospace;">
        <span id="rdpConnect">${escHtml(connect || '')}</span>
        <button class="btn btn-ghost btn-sm" onclick="copyRdp()">${svg('i-copy', 12)} Copy</button>
      </div>
      <div style="font-size:11px;color:var(--text-muted);margin-top:8px;">Log in with the VM's username and password. Choose the "Xorg" session if asked.</div>
    </div>` : ''}
    ${warn}
    ${note}`;
}

async function loadRdp() {
  clearTimeout(rdpTimer);
  let next = 6000;
  try {
    const r = await fetch(`/api/vms/${vmId}/rdp`);
    if (r.ok) {
      rdpLast = await r.json();
      renderRdp(rdpLast);
      if (rdpLast.status === 'installing') next = 2000;
    }
  } catch (e) { /* transient - retry on next tick */ }
  rdpTimer = setTimeout(loadRdp, next);
}

async function enableRdp() {
  try {
    const r = await fetch(`/api/vms/${vmId}/rdp/enable`, { method: 'POST', headers: { 'Content-Type': 'application/json' } });
    const j = await r.json().catch(() => ({}));
    if (!r.ok) { showToast(j.error || 'Could not enable RDP', 'error'); }
    else { showToast('RDP setup started - this can take a few minutes on a fresh VM', 'info'); }
  } catch (e) { showToast('Request failed: ' + e.message, 'error'); }
  loadRdp();
}

async function disableRdp() {
  if (!confirm('Disable RDP access for this VM? The host port is released. xrdp stays installed in the VM.')) return;
  try {
    const r = await fetch(`/api/vms/${vmId}/rdp/disable`, { method: 'POST', headers: { 'Content-Type': 'application/json' } });
    const j = await r.json().catch(() => ({}));
    showToast(r.ok ? 'RDP disabled' : (j.error || 'Could not disable RDP'), r.ok ? 'success' : 'error');
  } catch (e) { showToast('Request failed: ' + e.message, 'error'); }
  loadRdp();
}

function copyRdp() {
  const t = document.getElementById('rdpConnect')?.textContent;
  if (t) navigator.clipboard.writeText(t).then(() => showToast('RDP address copied to clipboard', 'success'));
}

function renderStatusIcon(enabled, label) {
  return enabled
    ? `<span style="display:inline-flex;align-items:center;gap:5px;color:#10B981;font-weight:600;">${svg('i-check-circle', 12)} ${label}</span>`
    : `<span style="display:inline-flex;align-items:center;gap:5px;color:#EF4444;font-weight:600;">${svg('i-x-circle', 12)} ${label}</span>`;
}

function renderInfoRow(label, value, mono = false, bold = false) {
  return `
    <div style="display: flex; justify-content: space-between; align-items: center; padding: 9px 0; border-bottom: 1px solid var(--border-subtle); gap: 12px;">
      <span style="font-size: 12px; color: var(--text-muted); flex-shrink: 0;">${escHtml(label)}</span>
      <span style="font-size: 12px; color: ${bold ? 'var(--text-primary)' : 'var(--text-secondary)'}; ${mono ? 'font-family: monospace; font-size: 11px;' : ''} ${bold ? 'font-weight: 600;' : ''} text-align: right; word-break: break-all;">${value === null || value === undefined ? '—' : String(value).includes('<span') ? value : escHtml(String(value))}</span>
    </div>`;
}

function formatBytes(mb) {
  if (!mb) return '—';
  if (mb >= 1024) return (mb / 1024).toFixed(1) + ' GB';
  return mb + ' MB';
}

function switchTab(tab) {
  document.querySelectorAll('.tab-btn').forEach(btn => {
    btn.classList.toggle('active', btn.dataset.tab === tab);
  });
  document.querySelectorAll('.tab-pane').forEach(pane => {
    pane.classList.toggle('active', pane.id === `tab-${tab}`);
  });
}

async function doAction(action) {
  if (action === 'reinstall') {
    openModal('reinstallModal');
    loadTemplatesForReinstall();
    return;
  }
  
  const msgs = {
    start: 'Start this VM?',
    stop: 'Stop this VM? Running processes will be interrupted.',
    restart: 'Restart this VM?'
  };
  
  const confirmed = await confirmAction(msgs[action] || `${action} VM?`, action.charAt(0).toUpperCase() + action.slice(1) + ' Virtual Machine');
  if (!confirmed) return;
  
  try {
    showToast(`${action.charAt(0).toUpperCase() + action.slice(1)}ing VM...`, 'info');
    const res = await fetch(`/api/vms/${vmId}/${action}`, { method: 'POST' });
    const data = await res.json();
    if (res.ok && data.success) {
      showToast(`VM ${{ start: 'started', stop: 'stopped', restart: 'restarted' }[action] || action + 'ed'} successfully`, 'success');
      setTimeout(loadVM, 1500);
    } else {
      showToast(`Failed: ${data.error || 'Unknown error'}`, 'error');
    }
  } catch(e) {
    showToast('Action failed: ' + e.message, 'error');
  }
}

async function deleteVM() {
  const confirmed = await confirmAction(
    `Permanently delete VM "${vmData?.vm_name || vmId}"? This will delete all files and cannot be undone!`,
    'Delete Virtual Machine',
    'danger'
  );
  if (!confirmed) return;
  
  try {
    showToast('Deleting VM...', 'warning');
    const res = await fetch(`/api/vms/${vmId}`, { method: 'DELETE' });
    if (res.ok) {
      showToast('VM deleted', 'success');
      setTimeout(() => { window.location.href = '/admin/vms'; }, 1000);
    } else {
      const data = await res.json();
      showToast('Failed: ' + (data.error || 'Unknown error'), 'error');
    }
  } catch(e) {
    showToast('Delete failed: ' + e.message, 'error');
  }
}

async function loadSnapshots() {
  const el = document.getElementById('snapshotsList');
  if (!el) return;
  try {
    const res = await fetch(`/api/vms/${vmId}/snapshots`);
    if (!res.ok) throw new Error('Failed');
    const snaps = await res.json();
    
    if (snaps.length === 0) {
      el.innerHTML = `
        <div class="empty-state" style="padding: 40px;">
          <div class="empty-state-icon" style="color:#8B5CF6;">${svg('i-camera', 48)}</div>
          <div class="empty-state-title">No Snapshots</div>
          <div class="empty-state-desc">Create snapshots to save VM state before major changes.</div>
        </div>`;
      return;
    }
    
    el.innerHTML = `<div style="display:grid; gap:10px;">` + snaps.map(s => `
      <div class="snapshot-item" style="display:flex; align-items:center; gap:12px; padding:14px; background:rgba(139,92,246,0.05); border:1px solid rgba(139,92,246,0.15); border-radius:10px; transition:all 0.2s;">
        <div style="width:36px; height:36px; border-radius:10px; background:rgba(139,92,246,0.15); color:#8B5CF6; display:flex; align-items:center; justify-content:center; flex-shrink:0;">${svg('i-camera', 18)}</div>
        <div class="snapshot-info" style="flex:1; min-width:0;">
          <div class="snapshot-name" style="font-weight:600; color:var(--text-primary); margin-bottom:2px;">${escHtml(s.snapshot_name)}</div>
          <div class="snapshot-meta" style="font-size:11px; color:var(--text-muted); display:inline-flex; align-items:center; gap:6px;">
            ${svg('i-clock', 11)}
            ${s.created_at ? new Date(s.created_at).toLocaleString() : '—'}
            ${s.description ? ` · ${escHtml(s.description)}` : ''}
          </div>
        </div>
        <span style="display:flex; gap:6px; flex-shrink:0;">
          <button class="mini-btn" onclick="restoreSnapshot(${s.snapshot_id}, '${escHtml(s.snapshot_name)}')" title="Roll the VM disk back to this snapshot">Restore</button>
          <button class="mini-btn danger" onclick="deleteSnapshot(${s.snapshot_id}, '${escHtml(s.snapshot_name)}')">Delete</button>
        </span>
      </div>
    `).join('') + `</div>`;
  } catch(e) {
    el.innerHTML = `<div style="color: var(--text-muted); font-size: 13px; text-align: center; padding: 20px;">Could not load snapshots</div>`;
  }
}

async function createSnapshot() {
  const name = document.getElementById('snapshotName')?.value.trim();
  const desc = document.getElementById('snapshotDesc')?.value.trim();
  
  if (!name) { showToast('Snapshot name required', 'warning'); return; }
  
  try {
    const res = await fetch(`/api/vms/${vmId}/snapshots`, {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ snapshot_name: name, description: desc })
    });
    const data = await res.json();
    if (res.ok && data.success) {
      showToast('Snapshot created', 'success');
      closeModal('snapshotModal');
      loadSnapshots();
    } else {
      showToast('Failed: ' + (data.error || 'Unknown error'), 'error');
    }
  } catch(e) {
    showToast('Failed: ' + e.message, 'error');
  }
}

async function loadLogs() {
  const el = document.getElementById('logsList');
  if (!el) return;
  try {
    const res = await fetch(`/api/vms/${vmId}/logs`);
    if (!res.ok) throw new Error('Failed');
