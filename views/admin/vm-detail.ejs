function copySSH() {
  const cmd = document.getElementById('sshCmd')?.textContent;
  if (cmd) {
    navigator.clipboard.writeText(cmd).then(() => showToast('SSH command copied to clipboard', 'success'));
  }
}

function escHtml(str) {
  if (!str) return '—';
  return String(str).replace(/[&<>"']/g, c => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]));
}

function openModal(id) {
  const m = document.getElementById(id);
  if (m) m.classList.add('show');
}

function closeModal(id) {
  const m = document.getElementById(id);
  if (m) m.classList.remove('show');
}

function showToast(msg, type = 'info') {
  let container = document.getElementById('toastContainer');
  if (!container) {
    container = document.createElement('div');
    container.id = 'toastContainer';
    container.className = 'toast-container';
    document.body.appendChild(container);
  }
  const iconMap = { success: 'i-check', error: 'i-x', warning: 'i-alert', info: 'i-info' };
  const toast = document.createElement('div');
  toast.className = `toast toast-${type}`;
  toast.innerHTML = `<span class="toast-icon">${svg(iconMap[type] || 'i-info', 16)}</span><span class="toast-message">${escHtml(msg)}</span><button class="toast-close" onclick="this.parentElement.remove()">×</button>`;
  container.appendChild(toast);
  setTimeout(() => { toast.classList.add('removing'); setTimeout(() => toast.remove(), 300); }, 4500);
}

function confirmAction(msg, title, variant = 'warning') {
  return new Promise((resolve) => {
    const isDanger = variant === 'danger';
    const overlay = document.createElement('div');
    overlay.style.cssText = 'position:fixed;inset:0;background:rgba(0,0,0,0.75);z-index:2000;display:flex;align-items:center;justify-content:center;padding:20px;backdrop-filter:blur(8px);';
    
    const modal = document.createElement('div');
    modal.style.cssText = 'background:var(--bg-card);border:1px solid var(--border-card);border-radius:var(--radius-lg);width:100%;max-width:460px;box-shadow:0 20px 60px rgba(0,0,0,0.6);animation:slideInModal 0.35s ease-out;overflow:hidden;';
    
    const iconColor = isDanger ? '#EF4444' : '#F59E0B';
    const iconBg = isDanger ? 'rgba(239,68,68,0.12)' : 'rgba(245,158,11,0.12)';
    const btnGrad = isDanger ? 'linear-gradient(135deg,#ef4444,#dc2626)' : 'linear-gradient(135deg,#f59e0b,#f97316)';
    const btnShadow = isDanger ? 'rgba(239,68,68,0.3)' : 'rgba(245,158,11,0.3)';
    
    modal.innerHTML = `
      <div style="padding:20px 22px 14px;border-bottom:1px solid var(--border-subtle);display:flex;align-items:center;gap:12px;">
        <div style="width:40px;height:40px;background:${iconBg};border-radius:10px;display:flex;align-items:center;justify-content:center;color:${iconColor};">
          ${svg(isDanger ? 'i-alert' : 'i-alert', 22)}
        </div>
        <h2 style="margin:0;color:var(--text-primary);font-size:16px;font-weight:700;">${escHtml(title)}</h2>
      </div>
      <div style="padding:20px 22px;">
        <p style="margin:0;color:var(--text-secondary);font-size:14px;line-height:1.5;">${escHtml(msg)}</p>
      </div>
      <div style="padding:14px 22px 18px;border-top:1px solid var(--border-subtle);display:flex;gap:10px;justify-content:flex-end;">
        <button id="cancelBtn" style="padding:9px 18px;border-radius:var(--radius-sm);cursor:pointer;font-weight:600;font-size:13px;background:transparent;color:var(--text-secondary);border:1px solid var(--border-color);">Cancel</button>
        <button id="confirmBtn" style="padding:9px 18px;border-radius:var(--radius-sm);cursor:pointer;border:none;font-weight:600;font-size:13px;background:${btnGrad};color:white;box-shadow:0 4px 12px ${btnShadow};">Confirm</button>
      </div>
    `;
    overlay.appendChild(modal);
    document.body.appendChild(overlay);
    
    const cleanup = () => overlay.remove();
    modal.querySelector('#confirmBtn').onclick = () => { cleanup(); resolve(true); };
    modal.querySelector('#cancelBtn').onclick = () => { cleanup(); resolve(false); };
    overlay.onclick = (e) => { if (e.target === overlay) { cleanup(); resolve(false); } };
    document.addEventListener('keydown', function esc(e) {
      if (e.key === 'Escape') { cleanup(); resolve(false); document.removeEventListener('keydown', esc); }
    });
  });
}

// Reinstall Functions
async function loadTemplatesForReinstall() {
  try {
    const res = await fetch('/api/os-templates');
    if (!res.ok) throw new Error('Failed to load templates');
    
    const templates = await res.json();
    const select = document.getElementById('reinstall_template');
    if (!select) return;
    
    select.innerHTML = '<option value="">— Choose Template —</option>';
    
    // Add all templates (both built-in and custom) from API
    if (templates && typeof templates === 'object') {
      Object.entries(templates).forEach(([key, template]) => {
        const opt = document.createElement('option');
        opt.value = key;
        
        // Show template name with indicator if custom
        const displayName = template.name || template.template_name || key;
        const isCustom = template.is_custom ? ' (Custom)' : '';
        opt.textContent = `${displayName}${isCustom}`;
        
        select.appendChild(opt);
      });
    }
  } catch (e) {
    console.error('Failed to load templates:', e.message);
    showToast('Failed to load templates', 'error');
  }
}

async function performReinstall(e) {
  e.preventDefault();
  
  const btn = document.getElementById('confirmReinstallBtn');
  
  btn.disabled = true;
  btn.innerHTML = `<span class="spinner spinner-sm" style="margin-right:6px;"></span> Reinstalling...`;
  
  try {
    const form = document.getElementById('reinstallForm');
    const fd = new FormData(form);
    const data = {
      new_os_template: fd.get('new_os_template'),
      new_username: fd.get('new_username') || undefined,
      new_password: fd.get('new_password') || undefined,
      confirm: fd.get('confirm') === 'on'
    };
    
    if (!data.new_os_template) throw new Error('Please select an OS template');
    if (!data.confirm) throw new Error('Please confirm the reinstall');
    
    const res = await fetch(`/api/vms/${vmId}/reinstall`, {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify(data)
    });
    
    const result = await res.json();
    
    if (res.ok && result.success) {
      showToast(result.message || 'VM reinstall started', 'success');
      closeModal('reinstallModal');
      setTimeout(() => loadVM(), 1500);
    } else {
      throw new Error(result.error || 'Reinstall failed');
    }
  } catch (e) {
    showToast('Reinstall error: ' + e.message, 'error');
    btn.innerHTML = `${svg('i-refresh', 14)} Reinstall`;
    btn.disabled = false;
  }
}

// ISO Management
async function loadISOStatus() {
  try {
    const res = await fetch(`/api/vms/${vmId}/iso/status`);
    if (!res.ok) return;
    
    const data = await res.json();
    const section = document.getElementById('isoManagementSection');
    const statusDiv = document.getElementById('isoStatus');
    const infoDiv = document.getElementById('isoInfo');
    const attachBtn = document.getElementById('attachISOBtn');
    const detachBtn = document.getElementById('detachISOBtn');
    
    if (!section) return;
    
    if (vmData && vmData.template_type === 'iso') {
      section.style.display = 'block';
      
      if (data.iso_attached) {
        statusDiv.textContent = `ISO Attached: ${data.iso_attached}`;
        infoDiv.innerHTML = `
          <div style="margin-bottom: 6px; display:inline-flex; align-items:center; gap:6px;">
            <span style="color:#06B6D4;">${svg('i-disc', 13)}</span>
            <strong>Current ISO:</strong> ${escHtml(data.iso_attached)}
          </div>
          <div style="font-size: 11px; color: var(--text-muted); display:inline-flex; align-items:center; gap:6px;">
            <span>${svg('i-power', 11)}</span> Boot Mode: ${data.boot_from_iso ? 'Boot from ISO' : 'Boot from Disk'} · 
            VM Status: ${data.vm_status ? data.vm_status.toUpperCase() : 'Unknown'}
          </div>
        `;
        attachBtn.style.display = 'none';
        detachBtn.style.display = 'inline-flex';
      } else {
        statusDiv.textContent = 'No ISO Attached';
        infoDiv.innerHTML = `
          <div style="color: var(--text-muted); font-size: 12px;">
            Attach an ISO file to boot from it. After installation, detach to boot from disk.
          </div>
        `;
        attachBtn.style.display = 'inline-flex';
        detachBtn.style.display = 'none';
      }
    } else {
      section.style.display = 'none';
    }
  } catch (e) {
    console.error('Failed to load ISO status:', e);
  }
}

async function loadISOFiles() {
  try {
    const res = await fetch('/api/iso-list');
    if (!res.ok) throw new Error('Failed to load ISOs');
    
    const files = await res.json();
    const select = document.getElementById('isoFileSelect');
    if (!select) return;
    
    select.innerHTML = '<option value="">— Select ISO file —</option>';
    if (files.length === 0) {
      select.innerHTML = '<option value="">No ISO files available</option>';
      select.disabled = true;
      return;
    }
    
    files.forEach(file => {
      const opt = document.createElement('option');
      opt.value = file;
      opt.textContent = file;
      select.appendChild(opt);
    });
  } catch (e) {
    console.error('Failed to load ISO files:', e);
    showToast('Failed to load ISO files', 'error');
  }
}

function openISOAttachModal() {
  loadISOFiles();
  openModal('isoAttachModal');
}

async function performISOAttach() {
  const select = document.getElementById('isoFileSelect');
  const isoFile = select.value;
  
  if (!isoFile) {
    showToast('Please select an ISO file', 'warning');
    return;
  }
  
  try {
    showToast('Attaching ISO...', 'info');
    const res = await fetch(`/api/vms/${vmId}/iso/attach`, {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ iso_file: isoFile })
    });
    
    const data = await res.json();
    
    if (res.ok && data.success) {
      showToast(data.message || 'ISO attached successfully', 'success');
      closeModal('isoAttachModal');
      loadISOStatus();
    } else {
      throw new Error(data.error || 'Failed to attach ISO');
    }
  } catch (e) {
    showToast('ISO attach failed: ' + e.message, 'error');
  }
}

async function detachISO() {
  const confirmed = await confirmAction('Detach the ISO and boot from disk on next start?', 'Detach ISO');
  if (!confirmed) return;
  
  try {
    showToast('Detaching ISO...', 'info');
    const res = await fetch(`/api/vms/${vmId}/iso/detach`, {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' }
    });
    
    const data = await res.json();
    
    if (res.ok && data.success) {
      showToast(data.message || 'ISO detached successfully', 'success');
      loadISOStatus();
    } else {
      throw new Error(data.error || 'Failed to detach ISO');
    }
  } catch (e) {
    showToast('ISO detach failed: ' + e.message, 'error');
  }
}

// ===== PLATFORM (Round 5): snapshot restore/delete, backups, clone, migrate, tags =====
async function restoreSnapshot(id, name) {
  if (!confirm('Restore snapshot "' + name + '"?\nThe VM disk rolls back to this point (VM must be stopped).')) return;
  try {
    const res = await fetch(`/api/vms/${vmId}/snapshots/${id}/restore`, { method: 'POST' });
    const data = await res.json();
    if (res.ok && data.success) { showToast(data.message || 'Snapshot restored', 'success'); loadVM(); }
    else showToast('Failed: ' + (data.message || data.error), 'error');
  } catch (e) { showToast('Failed: ' + e.message, 'error'); }
}
async function deleteSnapshot(id, name) {
  if (!confirm('Delete snapshot "' + name + '"?')) return;
  try {
    const res = await fetch(`/api/vms/${vmId}/snapshots/${id}`, { method: 'DELETE' });
    const data = await res.json();
    if (res.ok && data.success) { showToast('Snapshot deleted', 'success'); loadSnapshots(); }
    else showToast('Failed: ' + (data.message || data.error), 'error');
  } catch (e) { showToast('Failed: ' + e.message, 'error'); }
}
async function loadBackups() {
  // Round 5 fix: do NOT cache the element - loadVM()'s renderPage() rebuilds
  // the entire DOM after this first runs, detaching anything captured now.
  try {
    const res = await fetch(`/api/vms/${vmId}/backups`);
    if (!res.ok) throw new Error('Failed');
    const rows = await res.json();
    const el = document.getElementById('backupsList');
    if (!el) return;
    if (!rows.length) {
      el.innerHTML = '<div class="pempty" style="padding:24px;"><div class="pe-title">No backups yet</div><div class="pe-sub">Backups export the full disk as a standalone qcow2 with a SHA-256 checksum. Schedule them nightly from Task Automation.</div></div>';
      return;
    }
    el.innerHTML = rows.map(b => `
      <div style="display:flex; align-items:center; gap:12px; padding:12px 14px; border-radius:12px; border:1px solid var(--border-subtle); background:rgba(15,20,35,.35);">
        <div style="width:34px;height:34px;border-radius:10px;flex-shrink:0;display:flex;align-items:center;justify-content:center;background:rgba(52,211,153,.1);border:1px solid rgba(52,211,153,.22);color:#6ee7b7;">${svg('i-camera', 15)}</div>
        <div style="flex:1; min-width:0;">
          <div style="font-weight:650; color:var(--text-primary); font-size:13px;">${escHtml(b.name)}</div>
          <div style="font-size:11px; color:var(--text-muted); margin-top:2px;">${b.size_bytes ? VNM.fmt.bytes(b.size_bytes) : '—'} · ${b.node_name ? 'on node ' + escHtml(b.node_name) : 'panel-local'} · ${VNM.fmt.rel(b.created_at)}${b.checksum ? ' · checksum recorded' : ''}</div>
        </div>
        <span class="pill ${escHtml(b.status)}">${escHtml(b.status)}</span>
        <span style="display:flex; gap:6px;">
          ${b.status === 'ready' ? `<button class="mini-btn" onclick="verifyBackup(${b.id}, this)" title="Re-verify SHA-256 integrity">Verify</button>
          <button class="mini-btn" onclick="restoreBackup(${b.id})">Restore</button>
          <button class="mini-btn" onclick="testRestore(${b.id})" title="Restore into a fresh clone - this VM is untouched">Test</button>` : ''}
          <button class="mini-btn danger" onclick="deleteBackupRow(${b.id})">✕</button>
        </span>
      </div>`).join('');
  } catch (e) {
    el.innerHTML = '<div style="color:var(--text-muted); font-size:12.5px; text-align:center; padding:16px;">Could not load backups</div>';
  }
}
async function createBackupNow() {
  try {
    const res = await fetch(`/api/vms/${vmId}/backups`, { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ name: 'Backup ' + new Date().toLocaleString() }) });
    const data = await res.json();
    if (res.ok && data.success) { showToast('Backup queued - live progress in Task Automation', 'success'); setTimeout(loadBackups, 1500); }
    else showToast('Failed: ' + (data.message || data.error), 'error');
  } catch (e) { showToast('Failed: ' + e.message, 'error'); }
}
async function verifyBackup(id, btn) {
  btn.disabled = true;
  try {
    const res = await fetch(`/api/backups/${id}/verify`, { method: 'POST' });
    const data = await res.json();
    res.ok ? showToast('Integrity verified - SHA-256 matches', 'success') : showToast(data.message || 'Verification failed', 'error');
  } finally { btn.disabled = false; }
}
async function restoreBackup(id) {
  if (!confirm('RESTORE replaces this VM current disk with the backup.\nThe VM must be stopped. Continue?')) return;
  try {
    const res = await fetch(`/api/backups/${id}/restore`, { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ confirm: true }) });
    const data = await res.json();
    if (res.ok && data.success) showToast('Restore queued - checksum is verified before anything is touched', 'success');
    else showToast('Failed: ' + (data.message || data.error), 'error');
  } catch (e) { showToast('Failed: ' + e.message, 'error'); }
}
async function testRestore(id) {
  if (!confirm('Create a fresh clone VM from this backup to prove it restores? This VM is NOT touched.')) return;
  try {
    const res = await fetch(`/api/backups/${id}/restore-new`, { method: 'POST' });
    const data = await res.json();
    if (res.ok && data.success) showToast('Recovery test queued - a test VM will appear shortly', 'success');
    else showToast('Failed: ' + (data.message || data.error), 'error');
  } catch (e) { showToast('Failed: ' + e.message, 'error'); }
}
async function deleteBackupRow(id) {
  if (!confirm('Delete this backup file permanently?')) return;
  try {
    const res = await fetch(`/api/backups/${id}`, { method: 'DELETE' });
    if (res.ok) { showToast('Backup deleted', 'success'); loadBackups(); }
    else showToast('Could not delete', 'error');
  } catch (e) { showToast('Failed: ' + e.message, 'error'); }
}
async function loadMeta() {
  // Same fix as loadBackups: element refs are only valid AFTER the fetch
  // settles (renderPage may have rebuilt the DOM meanwhile).
  try {
    const res = await fetch(`/api/vms/${vmId}/platform-summary`);
    if (!res.ok) return;
    const d = await res.json();
    const tagsEl = document.getElementById('metaTags');
    if (!tagsEl) return;
    tagsEl.value = (d.vm.tags || []).join(', ');
    const gEl = document.getElementById('metaGroup');
    const nEl = document.getElementById('metaNotes');
    if (gEl) gEl.value = d.vm.vm_group || '';
    if (nEl) nEl.value = d.vm.notes || '';
  } catch (e) {}
}
async function saveMeta() {
  const tags = document.getElementById('metaTags').value.split(',').map(t => t.trim()).filter(Boolean);
  try {
    const res = await fetch(`/api/vms/${vmId}/meta`, {
      method: 'PUT', headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ tags, vm_group: document.getElementById('metaGroup').value.trim(), notes: document.getElementById('metaNotes').value.trim() })
    });
    if (res.ok) showToast('Saved', 'success'); else showToast('Could not save', 'error');
  } catch (e) { showToast('Failed: ' + e.message, 'error'); }
}
async function cloneVmNow() {
  const name = prompt('Name for the clone (blank = auto):', '');
  if (name === null) return;
  try {
    const res = await fetch(`/api/vms/${vmId}/clone`, { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ name: name || undefined }) });
    const data = await res.json();
    if (res.ok && data.success) showToast('Clone queued - watch Task Automation for progress', 'success');
    else showToast('Failed: ' + (data.message || data.error), 'error');
  } catch (e) { showToast('Failed: ' + e.message, 'error'); }
}
let _migrateTargets = [];
async function openMigrateModal() {
  if (!(window.VNM && VNM.premium && VNM.premium.ensure('live_migration'))) return;
  openModal('migrateModal');
  const chip = document.getElementById('migrateChip');
  if (chip) chip.style.display = 'none'; // already unlocked by the ensure() gate
  const box = document.getElementById('migrateTargets');
  box.innerHTML = '<div class="sk" style="height:58px;"></div>';
  try {
    const res = await fetch(`/api/vms/${vmId}/migrate/options`);
    if (!res.ok) throw new Error('Could not load migration targets');
    const d = await res.json();
    _migrateTargets = (d.targets || []).filter(t => t.eligible);
    if (!_migrateTargets.length) { box.innerHTML = '<div class="pempty"><div class="pe-title">No eligible target nodes</div><div class="pe-sub">Other nodes are offline, in maintenance mode, or out of capacity for this VM.</div></div>'; return; }
    box.innerHTML = _migrateTargets.map((t, i) => `
      <div class="place-card ${t.recommended ? 'recommended' : ''}" style="cursor:pointer" onclick="doMigrate(${i})">
        <div class="place-head">
          <div class="place-name">${t.recommended ? '<span class="rec-star">★</span> ' : ''}${esc ? esc(t.node.name) : t.node.name}</div>
          <span class="pill info">${t.node.mode || 'node'}</span>
        </div>
        <div style="font-size:11.5px;color:var(--text-muted);margin-top:5px;">${(t.reasons || []).slice(0, 3).map(r => esc ? esc(r) : r).join(' · ') || 'healthy'}</div>
      </div>`).join('');
  } catch (e) {
    box.innerHTML = '<div class="pempty">Could not load migration targets</div>';
  }
}
async function doMigrate(idx) {
  const t = _migrateTargets[idx];
  if (!t) return;
  if (!confirm(`Migrate this VM to "${t.node.name}"?\nThe VM is stopped during the move and restarted after (if it was running).`)) return;
  try {
    const r2 = await fetch(`/api/vms/${vmId}/migrate`, { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ target_node_id: t.node.id, start_after: true }) });
    const d2 = await r2.json();
    if (r2.ok && d2.success) { showToast('Migration queued - live progress in Task Automation', 'success'); closeModal('migrateModal'); }
    else showToast('Failed: ' + (d2.message || d2.error), 'error');
  } catch (e) { showToast('Failed: ' + e.message, 'error'); }
}

// Init
loadVM();
loadBackups();
loadMeta();
</script>
