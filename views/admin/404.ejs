<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="theme-color" content="#0a0a0f">
  <title><%= (typeof title !== 'undefined' ? title : 'Not Found') %> · VNM Panel</title>
  <link rel="icon" href="<%= typeof siteLogo !== 'undefined' ? siteLogo : '/images/logo-new.svg' %>" type="image/png">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
  <link rel="stylesheet" href="/css/admin.css">
  <link rel="stylesheet" href="/css/vnm-motion.css">
</head>
<body>
<div class="login-bg"></div>
<div class="login-bg-grid"></div>

<% 
  // Defensive locals: this template must render even when called with
  // only a subset of { title, message, code } (see app.js 404 paths).
  var errCode = typeof code !== 'undefined' ? code : 404;
  var errMsg = typeof message !== 'undefined' ? message
             : (typeof title !== 'undefined' ? title
             : 'The page you are looking for does not exist or has been moved.');
%>

<div class="error-page" style="position: relative; z-index: 1;">
  <div style="text-align: center; animation: fadeIn 0.6s ease;">
    <div class="error-code"><%= errCode %></div>
    <div class="error-title">Not Found</div>
    <div class="error-desc">
      <%= errMsg %>
    </div>

    <div style="display: flex; gap: 10px; justify-content: center; flex-wrap: wrap;">
      <a href="/dashboard" class="btn btn-primary btn-lg">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M3 9l9-7 9 7v11a2 2 0 01-2 2H5a2 2 0 01-2-2z"></path>
          <polyline points="9 22 9 12 15 12 15 22"></polyline>
        </svg>
        Go Home
      </a>
      <button onclick="history.back()" class="btn btn-ghost btn-lg">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <polyline points="15 18 9 12 15 6"></polyline>
        </svg>
        Go Back
      </button>
    </div>

    <div style="margin-top: 40px; display: flex; justify-content: center; gap: 20px; flex-wrap: wrap;">
      <a href="/admin/vms" style="color: var(--text-muted); text-decoration: none; font-size: 13px;">🖥️ VMs</a>
      <a href="/admin/users" style="color: var(--text-muted); text-decoration: none; font-size: 13px;">👥 Users</a>
      <a href="/admin/templates" style="color: var(--text-muted); text-decoration: none; font-size: 13px;">📦 Templates</a>
      <a href="/admin/settings" style="color: var(--text-muted); text-decoration: none; font-size: 13px;">⚙️ Settings</a>
      <a href="/admin/shield" style="color: var(--text-muted); text-decoration: none; font-size: 13px;">🛡️ Shield</a>
    </div>
  </div>
</div>
  <script src="/js/vnm-motion.js" defer></script>
</body>
</html>
