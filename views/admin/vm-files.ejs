// ---------------------------------------------------------------
// Rename
// ---------------------------------------------------------------
let renameTarget = null;
function fmOpenRename(name) {
  renameTarget = name;
  document.getElementById('renameNewName').value = name;
  openModal('modalRename');
  setTimeout(() => {
    const input = document.getElementById('renameNewName');
    input.focus();
    const dot = name.lastIndexOf('.');
    input.setSelectionRange(0, dot > 0 ? dot : name.length);
  }, 50);
}
async function fmDoRename() {
  const newName = document.getElementById('renameNewName').value.trim();
  if (!newName || !renameTarget) return;
  try {
    await fmApi('/rename', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ path: fmJoin(fmState.path, renameTarget), newName }) });
    closeModal('modalRename');
    showToast('Renamed', 'success');
    fmRefresh();
  } catch (e) { showToast(e.message, 'error'); }
}

// ---------------------------------------------------------------
// Delete
// ---------------------------------------------------------------
async function fmDeletePaths(names) {
  const ok = await confirmAction(
    names.length === 1 ? `Delete "${names[0]}"? This cannot be undone.` : `Delete ${names.length} items? This cannot be undone.`,
    'Delete', 'danger'
  );
  if (!ok) return;
  try {
    const paths = names.map(n => fmJoin(fmState.path, n));
    const data = await fmApi('/', { method: 'DELETE', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ paths }) });
    const failed = (data.results || []).filter(r => !r.success);
    if (failed.length) showToast(`${failed.length} item(s) could not be deleted`, 'warning');
    else showToast('Deleted', 'success');
    fmRefresh();
  } catch (e) { showToast(e.message, 'error'); }
}
function fmBulkDelete() { fmDeletePaths(Array.from(fmState.selected)); }

// ---------------------------------------------------------------
// Compress / Extract
// ---------------------------------------------------------------
let compressTargets = [];
function fmSyncCompressExt() {
  const nameEl = document.getElementById('compressName');
  const fmt = document.getElementById('compressFormat').value;
  const base = (nameEl.value || 'archive').replace(/\.(tar\.gz|tgz|tar|zip)$/i, '');
  nameEl.value = base + '.' + fmt;
}
function fmOpenCompress(names) {
  compressTargets = names;
  document.getElementById('compressItemsLabel').textContent = `${names.length} item(s): ${names.slice(0, 4).join(', ')}${names.length > 4 ? '…' : ''}`;
  document.getElementById('compressFormat').value = 'tar.gz';
  document.getElementById('compressName').value = (names.length === 1 ? names[0] : 'archive') + '.tar.gz';
  openModal('modalCompress');
}
function fmBulkCompress() { fmOpenCompress(Array.from(fmState.selected)); }
async function fmDoCompress() {
  const archiveName = document.getElementById('compressName').value.trim();
  const format = document.getElementById('compressFormat').value;
  if (!archiveName || compressTargets.length === 0) return;
  try {
    await fmApi('/compress', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ path: fmState.path, names: compressTargets, archiveName, format }) });
    closeModal('modalCompress');
    showToast('Archive created', 'success');
    fmRefresh();
  } catch (e) {
    showToast(e.message + (e.code === 'TOOL_MISSING' ? '' : ''), 'error');
  }
}

let extractTarget = null;
function fmOpenExtract(name) {
  extractTarget = name;
  document.getElementById('extractArchiveLabel').textContent = `Archive: ${name}`;
  document.getElementById('extractDestName').value = '';
  openModal('modalExtract');
}
async function fmDoExtract() {
  if (!extractTarget) return;
  const destName = document.getElementById('extractDestName').value.trim();
  try {
    await fmApi('/extract', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ path: fmState.path, archiveName: extractTarget, destName: destName || undefined }) });
    closeModal('modalExtract');
    showToast('Extracted', 'success');
    fmRefresh();
  } catch (e) { showToast(e.message, 'error'); }
}
function fmIsArchive(name) {
  return /\.(zip|tar|tar\.gz|tgz)$/i.test(name);
}

// ---------------------------------------------------------------
// Context menu
// ---------------------------------------------------------------
function fmShowContextMenu(evt, name) {
  evt.preventDefault();
  evt.stopPropagation();
  const entry = fmState.entries.find(e => e.name === name);
  if (!entry) return;
  const fullPath = fmJoin(fmState.path, name);
  const isDir = entry.type === 'directory';
  let items = [];
  items.push({ label: 'Open', icon: 'i-folder', action: () => fmOpenEntry(entry) });
  if (!isDir) items.push({ label: 'Download', icon: 'i-download', action: () => fmDownload(fullPath) });
  items.push({ label: 'Rename', icon: 'i-edit', action: () => fmOpenRename(name) });
  items.push({ label: 'Copy path', icon: 'i-copy', action: () => { navigator.clipboard && navigator.clipboard.writeText(fullPath); showToast('Path copied', 'info'); } });
  if (!isDir && fmIsArchive(name)) items.push({ label: 'Extract here', icon: 'i-archive', action: () => fmOpenExtract(name) });
  items.push({ label: 'Compress', icon: 'i-archive', action: () => fmOpenCompress([name]) });
  items.push({ sep: true });
  items.push({ label: 'Delete', icon: 'i-trash', danger: true, action: () => fmDeletePaths([name]) });

  const menu = document.getElementById('fmCtxMenu');
  menu.innerHTML = items.map((it) => it.sep
    ? '<div class="fm-ctx-sep"></div>'
    : `<div class="fm-ctx-item ${it.danger ? 'danger' : ''}" data-idx="${items.indexOf(it)}">${svg(it.icon, 14)} ${escHtml(it.label)}</div>`
  ).join('');
  Array.from(menu.querySelectorAll('.fm-ctx-item')).forEach((el) => {
    el.onclick = () => { fmHideContextMenu(); items[parseInt(el.dataset.idx)].action(); };
  });

  const x = evt.clientX, y = evt.clientY;
  menu.style.left = x + 'px';
  menu.style.top = y + 'px';
  menu.classList.add('show');
  const rect = menu.getBoundingClientRect();
  if (rect.right > window.innerWidth) menu.style.left = (window.innerWidth - rect.width - 8) + 'px';
  if (rect.bottom > window.innerHeight) menu.style.top = (window.innerHeight - rect.height - 8) + 'px';
}
function fmHideContextMenu() { document.getElementById('fmCtxMenu').classList.remove('show'); }
document.addEventListener('click', fmHideContextMenu);
document.addEventListener('scroll', fmHideContextMenu, true);

// ---------------------------------------------------------------
// Upload (drag & drop + picker), streamed via XHR for progress
// ---------------------------------------------------------------
function fmTriggerUpload() { document.getElementById('fmFileInput').click(); }
function fmHandleFileInput(fileList) {
  fmUploadFiles(fileList);
  document.getElementById('fmFileInput').value = '';
}
function fmGetCsrfToken() {
  const match = document.cookie.match(/(?:^|; )csrf_token=([^;]*)/);
  return match ? decodeURIComponent(match[1]) : null;
}
function fmUploadFiles(fileList) {
  if (fmState.offline) { showToast('VPS is offline', 'error'); return; }
  Array.from(fileList).forEach((file) => fmUploadOne(file));
}
function fmUploadOne(file) {
  const tray = document.getElementById('fmUploads');
  const item = document.createElement('div');
  item.className = 'fm-upload-item';
  item.innerHTML = `
    <div class="name">${escHtml(file.name)}</div>
    <div class="progress"><div class="progress-bar" style="width:0%"></div></div>
    <div class="meta"><span class="pct">0%</span><span class="status">Uploading…</span></div>`;
  tray.appendChild(item);
  const bar = item.querySelector('.progress-bar');
  const pctLabel = item.querySelector('.pct');
  const statusLabel = item.querySelector('.status');

  const xhr = new XMLHttpRequest();
  xhr.open('POST', API_BASE + '/upload?path=' + encodeURIComponent(fmState.path));
  const csrf = fmGetCsrfToken();
  if (csrf) xhr.setRequestHeader('X-CSRF-Token', csrf);

  const startTime = Date.now();
  xhr.upload.onprogress = (e) => {
    if (!e.lengthComputable) return;
    const pct = Math.round((e.loaded / e.total) * 100);
    bar.style.width = pct + '%';
    pctLabel.textContent = pct + '%';
    const elapsed = (Date.now() - startTime) / 1000;
    if (elapsed > 0.3) {
      const speed = e.loaded / elapsed;
      statusLabel.textContent = fmFormatBytes(speed) + '/s';
    }
  };
  xhr.onload = () => {
    let data = {};
    try { data = JSON.parse(xhr.responseText); } catch (e) {}
    if (xhr.status >= 200 && xhr.status < 300) {
      bar.className = 'progress-bar green';
      statusLabel.textContent = 'Done';
      pctLabel.textContent = '100%';
      setTimeout(() => item.remove(), 2500);
      fmRefresh();
    } else {
      bar.className = 'progress-bar red';
      statusLabel.textContent = data.error || 'Failed';
      showToast(`Upload failed: ${data.error || xhr.status}`, 'error');
    }
  };
  xhr.onerror = () => {
    bar.className = 'progress-bar red';
    statusLabel.textContent = 'Network error';
  };
  const form = new FormData();
  form.append('file', file);
  xhr.send(form);
}

// Drag & drop
const fmBody = document.getElementById('fmBody');
const fmDropzone = document.getElementById('fmDropzone');
let dragCounter = 0;
fmBody.addEventListener('dragenter', (e) => { e.preventDefault(); dragCounter++; if (!fmState.offline) fmDropzone.classList.add('show'); });
fmBody.addEventListener('dragover', (e) => e.preventDefault());
fmBody.addEventListener('dragleave', (e) => { dragCounter--; if (dragCounter <= 0) { dragCounter = 0; fmDropzone.classList.remove('show'); } });
fmBody.addEventListener('drop', (e) => {
  e.preventDefault();
  dragCounter = 0;
  fmDropzone.classList.remove('show');
  if (fmState.offline) { showToast('VPS is offline', 'error'); return; }
  if (e.dataTransfer && e.dataTransfer.files && e.dataTransfer.files.length) {
    fmUploadFiles(e.dataTransfer.files);
  }
});

// ---------------------------------------------------------------
// WebSocket live updates
// ---------------------------------------------------------------
function fmConnectWs() {
  const proto = window.location.protocol === 'https:' ? 'wss:' : 'ws:';
  ws = new WebSocket(proto + '//' + window.location.host + '/file-manager/' + vmId);
  ws.onmessage = (evt) => {
    try {
      const msg = JSON.parse(evt.data);
      if (msg.type === 'fs-changed') {
        clearTimeout(wsRefreshDebounce);
        wsRefreshDebounce = setTimeout(() => {
          if (!fmState.loading) fmLoadDirectory(fmState.path, { silent: true });
        }, 400);
      }
    } catch (e) { /* ignore */ }
  };
  ws.onclose = () => { /* no auto-reconnect spam - user can refresh the page */ };
  ws.onerror = () => {};
}

// ---------------------------------------------------------------
// Init
// ---------------------------------------------------------------
window.addEventListener('load', () => {
  fmLoadDirectory('/');
  fmConnectWs();
});
