<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="theme-color" content="#0a0a0f">
  <title><%= title || 'File Manager - VNM Admin Panel' %></title>
  <link rel="icon" href="<%= siteLogo %>" type="image/png">
  <link rel="stylesheet" href="/css/admin.css">
  <link rel="stylesheet" href="/css/vnm-motion.css">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/codemirror/5.65.16/codemirror.min.css">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/codemirror/5.65.16/theme/material-darker.min.css">
  <style>
    .fm-wrap { display:flex; flex-direction:column; gap:16px; height:calc(100vh - 140px); min-height:520px; }
    .fm-toolbar { display:flex; align-items:center; gap:10px; flex-wrap:wrap; }
    .fm-toolbar .spacer { flex:1; }
    .fm-search { position:relative; width:220px; max-width:45vw; }
    .fm-search input { width:100%; padding:8px 10px 8px 32px; background:var(--bg-input); border:1px solid var(--border-color); border-radius:var(--radius-sm); color:var(--text-primary); font-size:13px; }
    .fm-search input:focus { outline:none; border-color:rgba(255,255,255,0.35); }
    .fm-search svg { position:absolute; left:9px; top:50%; transform:translateY(-50%); color:var(--text-muted); }
    .fm-breadcrumb { display:flex; align-items:center; gap:4px; flex-wrap:wrap; font-size:13px; color:var(--text-secondary); background:var(--bg-card); border:1px solid var(--border-card); border-radius:var(--radius-md); padding:9px 12px; }
    .fm-crumb { color:var(--text-secondary); cursor:pointer; padding:3px 6px; border-radius:6px; transition:all var(--transition-fast); white-space:nowrap; }
    .fm-crumb:hover { background:rgba(255,255,255,0.06); color:var(--text-primary); }
    .fm-crumb.current { color:var(--text-primary); font-weight:600; cursor:default; }
    .fm-crumb.current:hover { background:none; }
    .fm-sep { color:var(--text-disabled); opacity:0.6; }
    .fm-storage { display:flex; align-items:center; gap:10px; font-size:12px; color:var(--text-muted); min-width:220px; }
    .fm-storage .progress { flex:1; height:6px; }
    .fm-body { flex:1; display:flex; flex-direction:column; background:var(--bg-card); border:1px solid var(--border-card); border-radius:var(--radius-lg); overflow:hidden; position:relative; }
    .fm-table-scroll { flex:1; overflow:auto; }
    .fm-table { width:100%; border-collapse:collapse; font-size:13px; }
    .fm-table thead th { position:sticky; top:0; background:var(--bg-elevated); text-align:left; padding:10px 12px; font-size:11px; text-transform:uppercase; letter-spacing:0.5px; color:var(--text-muted); border-bottom:1px solid var(--border-color); cursor:pointer; user-select:none; white-space:nowrap; z-index:5; }
    .fm-table thead th:hover { color:var(--text-primary); }
    .fm-table thead th.sorted::after { content:''; display:inline-block; margin-left:5px; width:0; height:0; border-left:4px solid transparent; border-right:4px solid transparent; }
    .fm-table thead th.sorted.asc::after { border-bottom:5px solid var(--text-primary); }
    .fm-table thead th.sorted.desc::after { border-top:5px solid var(--text-primary); }
    .fm-table tbody tr { border-bottom:1px solid var(--border-subtle); transition:background var(--transition-fast); cursor:default; }
    .fm-table tbody tr:hover { background:var(--bg-table-hover); }
    .fm-table tbody tr.selected { background:rgba(255,255,255,0.06); }
    .fm-table td { padding:8px 12px; color:var(--text-secondary); white-space:nowrap; }
    .fm-name-cell { display:flex; align-items:center; gap:9px; cursor:pointer; overflow:hidden; }
    .fm-name-cell .fm-icon { flex-shrink:0; width:20px; height:20px; display:flex; align-items:center; justify-content:center; color:var(--text-muted); }
    .fm-name-cell.is-dir .fm-icon { color:#F5C451; }
    .fm-name-text { overflow:hidden; text-overflow:ellipsis; color:var(--text-primary); font-weight:500; }
    .fm-check { width:34px; text-align:center; }
    .fm-check input { width:15px; height:15px; accent-color:#fff; cursor:pointer; }
    .fm-row-actions { display:flex; gap:4px; justify-content:flex-end; opacity:0; transition:opacity var(--transition-fast); }
    .fm-table tbody tr:hover .fm-row-actions { opacity:1; }
    .fm-icon-btn { width:26px; height:26px; border-radius:6px; border:1px solid transparent; background:transparent; color:var(--text-muted); display:inline-flex; align-items:center; justify-content:center; cursor:pointer; transition:all var(--transition-fast); }
    .fm-icon-btn:hover { background:rgba(255,255,255,0.08); color:var(--text-primary); border-color:var(--border-color); }
    .fm-bulkbar { display:none; align-items:center; gap:10px; padding:10px 14px; background:rgba(255,255,255,0.04); border-bottom:1px solid var(--border-color); font-size:12px; color:var(--text-secondary); }
    .fm-bulkbar.show { display:flex; }
    .fm-bulkbar .spacer { flex:1; }
    .fm-dropzone { position:absolute; inset:0; z-index:50; display:none; align-items:center; justify-content:center; flex-direction:column; gap:10px; background:rgba(10,10,15,0.88); border:2px dashed rgba(255,255,255,0.35); border-radius:var(--radius-lg); color:var(--text-primary); font-weight:600; pointer-events:none; }
    .fm-dropzone.show { display:flex; }
    .fm-uploads { position:fixed; bottom:18px; right:18px; width:320px; max-width:90vw; z-index:1500; display:flex; flex-direction:column; gap:8px; }
    .fm-upload-item { background:var(--bg-modal); border:1px solid var(--border-color); border-radius:var(--radius-sm); padding:10px 12px; box-shadow:var(--shadow-lg); }
    .fm-upload-item .name { font-size:12px; color:var(--text-primary); font-weight:600; overflow:hidden; text-overflow:ellipsis; white-space:nowrap; margin-bottom:6px; }
    .fm-upload-item .meta { font-size:11px; color:var(--text-muted); margin-top:5px; display:flex; justify-content:space-between; }
    .fm-ctx-menu { position:fixed; z-index:2500; min-width:180px; background:var(--bg-modal); border:1px solid var(--border-color); border-radius:var(--radius-md); box-shadow:0 20px 50px rgba(0,0,0,0.6); padding:6px; display:none; }
    .fm-ctx-menu.show { display:block; }
    .fm-ctx-item { display:flex; align-items:center; gap:10px; padding:8px 10px; border-radius:6px; font-size:13px; color:var(--text-secondary); cursor:pointer; }
    .fm-ctx-item:hover { background:rgba(255,255,255,0.07); color:var(--text-primary); }
    .fm-ctx-item.danger:hover { background:rgba(239,68,68,0.12); color:#EF4444; }
    .fm-ctx-sep { height:1px; background:var(--border-subtle); margin:5px 4px; }
    .fm-offline { display:flex; flex-direction:column; align-items:center; justify-content:center; gap:12px; flex:1; padding:40px; text-align:center; }
    .CodeMirror { height:100%; font-size:13px; }
    .fm-editor-modal .modal { max-width:960px; width:96vw; height:82vh; }
    .fm-editor-modal .modal-body { padding:0; flex:1; display:flex; flex-direction:column; overflow:hidden; }
    .fm-editor-toolbar { display:flex; align-items:center; gap:10px; padding:8px 14px; border-bottom:1px solid var(--border-subtle); font-size:12px; color:var(--text-muted); flex-shrink:0; }
    .fm-editor-toolbar .spacer { flex:1; }
    .fm-editor-body { flex:1; overflow:hidden; }
    .fm-switch { display:inline-flex; align-items:center; gap:6px; font-size:12px; color:var(--text-muted); cursor:pointer; }
    .fm-switch input { accent-color:#fff; }
    .fm-preview-img { max-width:100%; max-height:70vh; display:block; margin:0 auto; border-radius:8px; }
    .fm-skel-row td { padding:10px 12px; }
    .fm-skel { height:14px; border-radius:5px; }
    @media (max-width: 720px) {
      .fm-toolbar { gap:8px; }
      .fm-search { width:100%; order:5; }
      .fm-table thead th:nth-child(4), .fm-table td:nth-child(4),
      .fm-table thead th:nth-child(5), .fm-table td:nth-child(5) { display:none; }
    }
  </style>
</head>
<body>

<!-- ============ SVG ICON SPRITE ============ -->
<svg width="0" height="0" style="position:absolute" aria-hidden="true">
  <defs>
    <symbol id="i-back" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="15 18 9 12 15 6"/></symbol>
    <symbol id="i-folder" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 19a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h5l2 3h9a2 2 0 0 1 2 2z"/></symbol>
    <symbol id="i-folder-plus" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 19a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h5l2 3h9a2 2 0 0 1 2 2z"/><line x1="12" y1="11" x2="12" y2="17"/><line x1="9" y1="14" x2="15" y2="14"/></symbol>
    <symbol id="i-file" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/></symbol>
    <symbol id="i-file-plus" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="12" y1="12" x2="12" y2="18"/><line x1="9" y1="15" x2="15" y2="15"/></symbol>
    <symbol id="i-image" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="18" height="18" rx="2"/><circle cx="8.5" cy="8.5" r="1.5"/><polyline points="21 15 16 10 5 21"/></symbol>
    <symbol id="i-archive" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="18" height="5" rx="1"/><path d="M4 8v11a1 1 0 0 0 1 1h14a1 1 0 0 0 1-1V8"/><line x1="10" y1="12" x2="14" y2="12"/></symbol>
    <symbol id="i-upload" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="17 8 12 3 7 8"/><line x1="12" y1="3" x2="12" y2="15"/></symbol>
    <symbol id="i-download" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></symbol>
    <symbol id="i-trash" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="3 6 5 6 21 6"/><path d="M19 6l-1 14a2 2 0 0 1-2 2H8a2 2 0 0 1-2-2L5 6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"/></symbol>
    <symbol id="i-edit" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/></symbol>
    <symbol id="i-refresh" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="23 4 23 10 17 10"/><polyline points="1 20 1 14 7 14"/><path d="M3.51 9a9 9 0 0 1 14.85-3.36L23 10M1 14l4.64 4.36A9 9 0 0 0 20.49 15"/></symbol>
    <symbol id="i-search" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></symbol>
    <symbol id="i-home" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/></symbol>
    <symbol id="i-chevron-right" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"/></symbol>
    <symbol id="i-more" viewBox="0 0 24 24" fill="currentColor"><circle cx="12" cy="5" r="1.6"/><circle cx="12" cy="12" r="1.6"/><circle cx="12" cy="19" r="1.6"/></symbol>
    <symbol id="i-check" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></symbol>
    <symbol id="i-x" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></symbol>
    <symbol id="i-alert" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"/><line x1="12" y1="9" x2="12" y2="13"/><line x1="12" y1="17" x2="12.01" y2="17"/></symbol>
    <symbol id="i-info" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><line x1="12" y1="16" x2="12" y2="12"/><line x1="12" y1="8" x2="12.01" y2="8"/></symbol>
    <symbol id="i-power" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18.36 6.64a9 9 0 1 1-12.73 0"/><line x1="12" y1="2" x2="12" y2="12"/></symbol>
    <symbol id="i-save" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M19 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11l5 5v11a2 2 0 0 1-2 2z"/><polyline points="17 21 17 13 7 13 7 21"/><polyline points="7 3 7 8 15 8"/></symbol>
    <symbol id="i-copy" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="9" y="9" width="13" height="13" rx="2"/><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/></symbol>
    <symbol id="i-lock" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="11" width="18" height="11" rx="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></symbol>
    <symbol id="i-spinner" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="12" y1="2" x2="12" y2="6"/><line x1="12" y1="18" x2="12" y2="22"/><line x1="4.93" y1="4.93" x2="7.76" y2="7.76"/><line x1="16.24" y1="16.24" x2="19.07" y2="19.07"/><line x1="2" y1="12" x2="6" y2="12"/><line x1="18" y1="12" x2="22" y2="12"/><line x1="4.93" y1="19.07" x2="7.76" y2="16.24"/><line x1="16.24" y1="7.76" x2="19.07" y2="4.93"/></symbol>
  </defs>
</svg>

<div class="admin-wrapper">
  <%- include('../partials/admin/sidebar') %>

  <div class="admin-main">
    <%- include('../partials/admin/header') %>

    <div class="page-content">
      <div class="page-header" style="align-items:center;">
        <div style="display:flex; align-items:center; gap:14px; flex:1; min-width:0;">
          <a href="/admin/vm/<%= vmId %>" style="color: var(--text-muted); text-decoration:none; display:inline-flex; align-items:center; gap:4px; font-size:13px; flex-shrink:0;">
            <svg width="14" height="14"><use href="#i-back"/></svg>
            Back
          </a>
          <div style="min-width:0;">
            <h1 class="page-title" style="margin:0; white-space:nowrap; overflow:hidden; text-overflow:ellipsis;">File Manager</h1>
            <p style="font-size:12px; color:var(--text-muted); margin-top:3px;">VPS <span style="font-family:monospace;">#<%= vmId %></span></p>
          </div>
        </div>
        <div class="page-actions">
          <div class="fm-storage" id="storageBar" style="display:none;">
            <span id="storageLabel">—</span>
            <div class="progress"><div class="progress-bar" id="storageProgressBar" style="width:0%"></div></div>
          </div>
        </div>
      </div>

      <div class="fm-wrap">
        <div class="fm-toolbar">
          <button class="btn btn-outline btn-sm" onclick="fmOpenCreateFolder()"><svg width="13" height="13"><use href="#i-folder-plus"/></svg> New Folder</button>
          <button class="btn btn-outline btn-sm" onclick="fmOpenCreateFile()"><svg width="13" height="13"><use href="#i-file-plus"/></svg> New File</button>
          <button class="btn btn-outline btn-sm" onclick="fmTriggerUpload()"><svg width="13" height="13"><use href="#i-upload"/></svg> Upload</button>
          <input type="file" id="fmFileInput" multiple style="display:none;" onchange="fmHandleFileInput(this.files)">
          <button class="btn btn-ghost btn-sm" onclick="fmRefresh()" title="Refresh"><svg width="13" height="13"><use href="#i-refresh"/></svg></button>
          <div class="spacer"></div>
          <div class="fm-search">
            <svg width="14" height="14"><use href="#i-search"/></svg>
            <input type="text" id="fmSearchInput" placeholder="Search this folder..." oninput="fmOnSearchInput()">
          </div>
        </div>

        <div class="fm-breadcrumb" id="fmBreadcrumb"></div>

        <div class="fm-body" id="fmBody">
          <div class="fm-bulkbar" id="fmBulkBar">
            <span id="fmBulkCount">0 selected</span>
            <div class="spacer"></div>
            <button class="btn btn-ghost btn-sm" onclick="fmBulkCompress()"><svg width="12" height="12"><use href="#i-archive"/></svg> Compress</button>
            <button class="btn btn-ghost btn-sm" onclick="fmBulkDownload()"><svg width="12" height="12"><use href="#i-download"/></svg> Download</button>
            <button class="btn btn-danger btn-sm" onclick="fmBulkDelete()"><svg width="12" height="12"><use href="#i-trash"/></svg> Delete</button>
            <button class="btn btn-ghost btn-sm" onclick="fmClearSelection()">Clear</button>
          </div>

          <div class="fm-table-scroll">
            <table class="fm-table">
              <thead>
                <tr>
                  <th class="fm-check"><input type="checkbox" id="fmSelectAll" onchange="fmToggleSelectAll(this.checked)"></th>
                  <th id="fmSortName" onclick="fmSetSort('name')">Name</th>
                  <th id="fmSortSize" onclick="fmSetSort('size')">Size</th>
                  <th id="fmSortModified" onclick="fmSetSort('modified')">Modified</th>
                  <th>Permissions</th>
                  <th style="text-align:right;">Actions</th>
                </tr>
              </thead>
              <tbody id="fmTableBody"></tbody>
            </table>
          </div>

          <div class="fm-dropzone" id="fmDropzone">
            <svg width="40" height="40"><use href="#i-upload"/></svg>
            <div>Drop files to upload</div>
          </div>
        </div>
      </div>
    </div>

    <%- include('../partials/admin/footer') %>
  </div>
</div>

<!-- ============ Context Menu ============ -->
<div class="fm-ctx-menu" id="fmCtxMenu"></div>

<!-- ============ Create Folder Modal ============ -->
<div class="modal-overlay" id="modalCreateFolder">
  <div class="modal" style="max-width:420px;">
    <div class="modal-header">
      <div class="modal-title"><svg width="18" height="18"><use href="#i-folder-plus"/></svg> New Folder</div>
      <button class="modal-close" onclick="closeModal('modalCreateFolder')"><svg width="16" height="16"><use href="#i-x"/></svg></button>
    </div>
    <div class="modal-body">
      <div class="form-group">
        <label class="form-label">Folder name</label>
        <input type="text" class="form-control" id="createFolderName" placeholder="new-folder" onkeydown="if(event.key==='Enter')fmCreateFolder()">
      </div>
    </div>
    <div class="modal-footer">
      <button class="btn btn-ghost btn-sm" onclick="closeModal('modalCreateFolder')">Cancel</button>
      <button class="btn btn-primary btn-sm" onclick="fmCreateFolder()">Create</button>
    </div>
  </div>
</div>

<!-- ============ Create File Modal ============ -->
<div class="modal-overlay" id="modalCreateFile">
  <div class="modal" style="max-width:420px;">
    <div class="modal-header">
      <div class="modal-title"><svg width="18" height="18"><use href="#i-file-plus"/></svg> New File</div>
      <button class="modal-close" onclick="closeModal('modalCreateFile')"><svg width="16" height="16"><use href="#i-x"/></svg></button>
    </div>
    <div class="modal-body">
      <div class="form-group">
        <label class="form-label">File name</label>
        <input type="text" class="form-control" id="createFileName" placeholder="notes.txt" onkeydown="if(event.key==='Enter')fmCreateFile()">
      </div>
    </div>
    <div class="modal-footer">
      <button class="btn btn-ghost btn-sm" onclick="closeModal('modalCreateFile')">Cancel</button>
      <button class="btn btn-primary btn-sm" onclick="fmCreateFile()">Create</button>
    </div>
  </div>
</div>

<!-- ============ Rename Modal ============ -->
<div class="modal-overlay" id="modalRename">
  <div class="modal" style="max-width:420px;">
    <div class="modal-header">
      <div class="modal-title"><svg width="18" height="18"><use href="#i-edit"/></svg> Rename</div>
      <button class="modal-close" onclick="closeModal('modalRename')"><svg width="16" height="16"><use href="#i-x"/></svg></button>
    </div>
    <div class="modal-body">
      <div class="form-group">
        <label class="form-label">New name</label>
        <input type="text" class="form-control" id="renameNewName" onkeydown="if(event.key==='Enter')fmDoRename()">
      </div>
    </div>
    <div class="modal-footer">
