<script src="https://cdnjs.cloudflare.com/ajax/libs/codemirror/5.65.16/codemirror.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/codemirror/5.65.16/mode/javascript/javascript.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/codemirror/5.65.16/mode/python/python.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/codemirror/5.65.16/mode/shell/shell.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/codemirror/5.65.16/mode/yaml/yaml.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/codemirror/5.65.16/mode/xml/xml.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/codemirror/5.65.16/mode/css/css.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/codemirror/5.65.16/mode/htmlmixed/htmlmixed.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/codemirror/5.65.16/mode/markdown/markdown.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/codemirror/5.65.16/mode/sql/sql.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/codemirror/5.65.16/mode/clike/clike.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/codemirror/5.65.16/mode/toml/toml.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/codemirror/5.65.16/mode/properties/properties.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/codemirror/5.65.16/addon/search/searchcursor.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/codemirror/5.65.16/addon/search/search.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/codemirror/5.65.16/addon/dialog/dialog.min.js"></script>
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/codemirror/5.65.16/addon/dialog/dialog.min.css">

<script>
/* =====================================================================
   VNM Panel — Live VPS File Manager (frontend)
   Talks to /api/vms/:vmId/files/* (see filemanager.js on the server).
   ===================================================================== */
const vmId = <%= vmId %>;
const API_BASE = `/api/vms/${vmId}/files`; // shared endpoint - server applies admin bypass on ownership check

let fmState = {
  path: '/',
  entries: [],
  parent: null,
  sortKey: 'name',
  sortOrder: 'asc',
  search: '',
  selected: new Set(),
  offline: false,
  loading: false
};
let searchDebounce = null;
let wsRefreshDebounce = null;
let ws = null;

function svg(id, size = 14) {
  return `<svg width="${size}" height="${size}"><use href="#${id}"/></svg>`;
}
function escHtml(str) {
  if (str === null || str === undefined || str === '') return '';
  return String(str).replace(/[&<>"']/g, c => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]));
}
function openModal(id) { const m = document.getElementById(id); if (m) m.classList.add('show'); }
function closeModal(id) { const m = document.getElementById(id); if (m) m.classList.remove('show'); }

function showToast(msg, type = 'info') {
  let container = document.getElementById('toastContainer');
  if (!container) {
    container = document.createElement('div');
    container.id = 'toastContainer';
    container.className = 'toast-container';
    document.body.appendChild(container);
  }
  const iconMap = { success: 'i-check', error: 'i-x', warning: 'i-alert', info: 'i-info' };
  const toast = document.createElement('div');
  toast.className = `toast toast-${type}`;
  toast.innerHTML = `<span class="toast-icon">${svg(iconMap[type] || 'i-info', 16)}</span><span class="toast-message">${escHtml(msg)}</span><button class="toast-close" onclick="this.parentElement.remove()">×</button>`;
  container.appendChild(toast);
  setTimeout(() => { toast.classList.add('removing'); setTimeout(() => toast.remove(), 300); }, 4500);
}

function confirmAction(msg, title, variant = 'warning') {
  return new Promise((resolve) => {
    const isDanger = variant === 'danger';
    const overlay = document.createElement('div');
    overlay.style.cssText = 'position:fixed;inset:0;background:rgba(0,0,0,0.75);z-index:3000;display:flex;align-items:center;justify-content:center;padding:20px;backdrop-filter:blur(8px);';
    const modal = document.createElement('div');
    modal.style.cssText = 'background:var(--bg-card);border:1px solid var(--border-card);border-radius:var(--radius-lg);width:100%;max-width:460px;box-shadow:0 20px 60px rgba(0,0,0,0.6);overflow:hidden;';
    const iconColor = isDanger ? '#EF4444' : '#F59E0B';
    const iconBg = isDanger ? 'rgba(239,68,68,0.12)' : 'rgba(245,158,11,0.12)';
    const btnGrad = isDanger ? 'linear-gradient(135deg,#ef4444,#dc2626)' : 'linear-gradient(135deg,#f59e0b,#f97316)';
    modal.innerHTML = `
      <div style="padding:20px 22px 14px;border-bottom:1px solid var(--border-subtle);display:flex;align-items:center;gap:12px;">
        <div style="width:40px;height:40px;background:${iconBg};border-radius:10px;display:flex;align-items:center;justify-content:center;color:${iconColor};">${svg('i-alert', 22)}</div>
        <h2 style="margin:0;color:var(--text-primary);font-size:16px;font-weight:700;">${escHtml(title)}</h2>
      </div>
      <div style="padding:20px 22px;"><p style="margin:0;color:var(--text-secondary);font-size:14px;line-height:1.5;">${escHtml(msg)}</p></div>
      <div style="padding:14px 22px 18px;border-top:1px solid var(--border-subtle);display:flex;gap:10px;justify-content:flex-end;">
        <button id="cancelBtn" style="padding:9px 18px;border-radius:var(--radius-sm);cursor:pointer;font-weight:600;font-size:13px;background:transparent;color:var(--text-secondary);border:1px solid var(--border-color);">Cancel</button>
        <button id="confirmBtn" style="padding:9px 18px;border-radius:var(--radius-sm);cursor:pointer;border:none;font-weight:600;font-size:13px;background:${btnGrad};color:white;">Confirm</button>
      </div>`;
    overlay.appendChild(modal);
    document.body.appendChild(overlay);
    const cleanup = () => overlay.remove();
    modal.querySelector('#confirmBtn').onclick = () => { cleanup(); resolve(true); };
    modal.querySelector('#cancelBtn').onclick = () => { cleanup(); resolve(false); };
    overlay.onclick = (e) => { if (e.target === overlay) { cleanup(); resolve(false); } };
  });
}

async function fmApi(path, opts) {
  opts = opts || {};
  const res = await fetch(API_BASE + path, opts);
  let data;
  try { data = await res.json(); } catch (e) { data = { error: 'Unexpected server response' }; }
  if (!res.ok) {
    const err = new Error(data.error || `Request failed (HTTP ${res.status})`);
    err.status = res.status;
    err.code = data.code;
    throw err;
  }
  return data;
}

function fmFormatBytes(bytes) {
  if (bytes === null || bytes === undefined) return '—';
  if (bytes === 0) return '0 B';
  const units = ['B', 'KB', 'MB', 'GB', 'TB'];
  const i = Math.min(units.length - 1, Math.floor(Math.log(bytes) / Math.log(1024)));
  return (bytes / Math.pow(1024, i)).toFixed(i === 0 ? 0 : 1) + ' ' + units[i];
}
function fmFormatDate(ms) {
  if (!ms) return '—';
  const d = new Date(ms);
  return d.toLocaleDateString(undefined, { month: 'short', day: 'numeric', year: 'numeric' }) + ' ' + d.toLocaleTimeString(undefined, { hour: '2-digit', minute: '2-digit' });
}
function fmJoin(dir, name) {
  return dir === '/' ? '/' + name : dir.replace(/\/$/, '') + '/' + name;
}

// ---------------------------------------------------------------
// Directory loading / rendering
// ---------------------------------------------------------------
async function fmLoadDirectory(path, opts) {
  opts = opts || {};
  fmState.loading = true;
  if (!opts.silent) fmRenderSkeleton();
  try {
    const q = new URLSearchParams({ path, sort: fmState.sortKey, order: fmState.sortOrder, search: fmState.search });
    const data = await fmApi('/?' + q.toString());
    fmState.path = data.path;
    fmState.parent = data.parent;
    fmState.entries = data.entries;
    fmState.offline = false;
    fmClearSelection();
    fmRenderBreadcrumb();
    fmRenderTable();
    fmRenderSortIndicators();
    if (!opts.skipStorage) fmLoadStorage();
  } catch (e) {
    if (e.code === 'VPS_OFFLINE') {
      fmState.offline = true;
      fmRenderOffline(e.message);
      document.getElementById('storageBar').style.display = 'none';
    } else {
      showToast(e.message || 'Could not load directory', 'error');
      fmRenderError(e.message);
    }
  } finally {
    fmState.loading = false;
  }
}

function fmRefresh() {
  fmLoadDirectory(fmState.path);
}

async function fmLoadStorage() {
  try {
    const data = await fmApi('/storage');
    const bar = document.getElementById('storageBar');
    bar.style.display = 'flex';
    const pct = data.totalBytes ? Math.min(100, Math.round((data.usedBytes / data.totalBytes) * 100)) : 0;
    document.getElementById('storageLabel').textContent =
      `${fmFormatBytes(data.usedBytes)} / ${fmFormatBytes(data.totalBytes)} used`;
    const barEl = document.getElementById('storageProgressBar');
    barEl.style.width = pct + '%';
    barEl.className = 'progress-bar ' + (pct > 90 ? 'red' : pct > 75 ? 'orange' : 'green');
  } catch (e) {
    document.getElementById('storageBar').style.display = 'none';
  }
}

function fmRenderSkeleton() {
  const tbody = document.getElementById('fmTableBody');
  let rows = '';
  for (let i = 0; i < 6; i++) {
    rows += `<tr class="fm-skel-row"><td></td><td><div class="fm-skel skeleton" style="width:${60 + Math.random()*30}%"></div></td><td><div class="fm-skel skeleton" style="width:40px"></div></td><td><div class="fm-skel skeleton" style="width:90px"></div></td><td><div class="fm-skel skeleton" style="width:50px"></div></td><td></td></tr>`;
  }
  tbody.innerHTML = rows;
}

function fmRenderOffline(message) {
  document.getElementById('fmBody').querySelector('.fm-table-scroll').innerHTML = `
    <div class="fm-offline">
      <div style="width:56px;height:56px;border-radius:14px;background:rgba(245,158,11,0.12);color:#F59E0B;display:flex;align-items:center;justify-content:center;">${svg('i-power', 28)}</div>
      <div style="font-size:16px;font-weight:700;color:var(--text-primary);">VPS is offline</div>
      <div style="font-size:13px;color:var(--text-muted);max-width:360px;">The file manager needs the VPS to be running so it can reach the live filesystem over SSH. Start the VPS, then retry.</div>
      <button class="btn btn-outline btn-sm" onclick="fmRefresh()">${svg('i-refresh',13)} Retry</button>
    </div>`;
}
function fmRenderError(message) {
  document.getElementById('fmBody').querySelector('.fm-table-scroll').innerHTML = `
    <div class="fm-offline">
      <div style="width:56px;height:56px;border-radius:14px;background:rgba(239,68,68,0.12);color:#EF4444;display:flex;align-items:center;justify-content:center;">${svg('i-alert', 28)}</div>
      <div style="font-size:16px;font-weight:700;color:var(--text-primary);">Could not load this folder</div>
      <div style="font-size:13px;color:var(--text-muted);max-width:360px;">${escHtml(message || 'Unknown error')}</div>
      <button class="btn btn-outline btn-sm" onclick="fmRefresh()">${svg('i-refresh',13)} Retry</button>
    </div>`;
}

function fmRenderBreadcrumb() {
  const parts = fmState.path === '/' ? [] : fmState.path.split('/').filter(Boolean);
  let html = `<span class="fm-crumb ${parts.length === 0 ? 'current' : ''}" onclick="fmLoadDirectory('/')">${svg('i-home', 13)}</span>`;
  let acc = '';
  parts.forEach((part, i) => {
    acc += '/' + part;
    const isLast = i === parts.length - 1;
    html += `<span class="fm-sep">${svg('i-chevron-right', 11)}</span>`;
    html += `<span class="fm-crumb ${isLast ? 'current' : ''}" ${isLast ? '' : `onclick="fmLoadDirectory('${acc.replace(/'/g, "\\'")}')"`}>${escHtml(part)}</span>`;
  });
  document.getElementById('fmBreadcrumb').innerHTML = html;
}

function fmRenderSortIndicators() {
  ['name', 'size', 'modified'].forEach((key) => {
    const th = document.getElementById('fmSort' + key.charAt(0).toUpperCase() + key.slice(1));
    th.classList.remove('sorted', 'asc', 'desc');
    if (fmState.sortKey === key) th.classList.add('sorted', fmState.sortOrder);
  });
}

function fmSetSort(key) {
  if (fmState.sortKey === key) {
    fmState.sortOrder = fmState.sortOrder === 'asc' ? 'desc' : 'asc';
  } else {
    fmState.sortKey = key;
    fmState.sortOrder = 'asc';
  }
  fmLoadDirectory(fmState.path);
}

function fmOnSearchInput() {
  clearTimeout(searchDebounce);
  const val = document.getElementById('fmSearchInput').value;
  searchDebounce = setTimeout(() => {
    fmState.search = val;
    fmLoadDirectory(fmState.path);
  }, 300);
}

const EXT_ICON = {
  dir: 'i-folder',
  archive: 'i-archive',
  image: 'i-image',
  file: 'i-file'
};
const IMAGE_EXTS = new Set(['png','jpg','jpeg','gif','webp','bmp','ico','svg']);
const ARCHIVE_EXTS = new Set(['zip','tar','gz','tgz','rar','7z']);
const TEXT_EXTS = new Set(['txt','md','markdown','json','yml','yaml','js','mjs','cjs','ts','tsx','jsx',
  'html','htm','css','scss','sh','bash','zsh','py','rb','go','rs','c','h','cpp','hpp','java','php',
  'sql','xml','conf','cfg','ini','env','log','toml','properties','gitignore','dockerfile','service','yaml']);

function fmExt(name) {
  const i = name.lastIndexOf('.');
  if (i === -1 || i === 0) return '';
  return name.slice(i + 1).toLowerCase();
}
function fmIconFor(entry) {
  if (entry.type === 'directory') return EXT_ICON.dir;
  const ext = fmExt(entry.name);
  if (IMAGE_EXTS.has(ext)) return EXT_ICON.image;
  if (ARCHIVE_EXTS.has(ext) || /\.tar\.gz$/i.test(entry.name)) return EXT_ICON.archive;
  return EXT_ICON.file;
}

function fmRenderTable() {
  const tbody = document.getElementById('fmTableBody');
  if (fmState.entries.length === 0) {
    tbody.innerHTML = `<tr><td colspan="6"><div class="empty-state" style="padding:40px 20px;">
      <div class="empty-state-icon">${svg('i-folder', 40)}</div>
      <div class="empty-state-title">${fmState.search ? 'No matches' : 'This folder is empty'}</div>
      <div class="empty-state-desc">${fmState.search ? 'Try a different search term.' : 'Upload a file or create a new folder to get started.'}</div>
    </div></td></tr>`;
    return;
  }
  tbody.innerHTML = fmState.entries.map((entry) => {
    const isDir = entry.type === 'directory';
    const fullPath = fmJoin(fmState.path, entry.name);
    const icon = fmIconFor(entry);
    return `<tr data-name="${escHtml(entry.name)}" oncontextmenu="fmShowContextMenu(event, ${JSON.stringify(entry.name).replace(/"/g,'&quot;')})">
      <td class="fm-check"><input type="checkbox" data-select="${escHtml(entry.name)}" onchange="fmToggleSelect('${entry.name.replace(/'/g,"\\'")}', this.checked)"></td>
      <td>
        <div class="fm-name-cell ${isDir ? 'is-dir' : ''}" onclick="fmOpenEntry(${JSON.stringify(entry).replace(/"/g,'&quot;')})">
          <span class="fm-icon">${svg(icon, 17)}</span>
          <span class="fm-name-text" title="${escHtml(entry.name)}">${escHtml(entry.name)}</span>
        </div>
      </td>
      <td>${isDir ? '—' : fmFormatBytes(entry.size)}</td>
      <td>${fmFormatDate(entry.modified)}</td>
      <td style="font-family:monospace; font-size:11px; color:var(--text-muted);">${entry.permissions || '—'}</td>
      <td>
        <div class="fm-row-actions">
          ${!isDir ? `<button class="fm-icon-btn" title="Download" onclick="fmDownload('${fullPath.replace(/'/g,"\\'")}')">${svg('i-download',14)}</button>` : ''}
          <button class="fm-icon-btn" title="Rename" onclick="fmOpenRename('${entry.name.replace(/'/g,"\\'")}')">${svg('i-edit',14)}</button>
          <button class="fm-icon-btn" title="More" onclick="fmShowContextMenu(event, ${JSON.stringify(entry.name).replace(/"/g,'&quot;')})">${svg('i-more',14)}</button>
        </div>
      </td>
    </tr>`;
  }).join('');
}

// ---------------------------------------------------------------
// Selection
// ---------------------------------------------------------------
function fmToggleSelect(name, checked) {
  if (checked) fmState.selected.add(name); else fmState.selected.delete(name);
  fmUpdateBulkBar();
  const row = document.querySelector(`tr[data-name="${CSS.escape(name)}"]`);
  if (row) row.classList.toggle('selected', checked);
}
function fmToggleSelectAll(checked) {
  fmState.selected = new Set(checked ? fmState.entries.map(e => e.name) : []);
  document.querySelectorAll('#fmTableBody input[type=checkbox]').forEach(cb => cb.checked = checked);
  document.querySelectorAll('#fmTableBody tr').forEach(tr => tr.classList.toggle('selected', checked));
  fmUpdateBulkBar();
}
function fmClearSelection() {
  fmState.selected = new Set();
  const sa = document.getElementById('fmSelectAll');
  if (sa) sa.checked = false;
  fmUpdateBulkBar();
}
function fmUpdateBulkBar() {
  const bar = document.getElementById('fmBulkBar');
  const n = fmState.selected.size;
  bar.classList.toggle('show', n > 0);
  document.getElementById('fmBulkCount').textContent = `${n} selected`;
}

// ---------------------------------------------------------------
// Opening entries (navigate / preview / edit)
// ---------------------------------------------------------------
function fmOpenEntry(entry) {
  const fullPath = fmJoin(fmState.path, entry.name);
  if (entry.type === 'directory') {
    document.getElementById('fmSearchInput').value = '';
    fmState.search = '';
    return fmLoadDirectory(fullPath);
  }
  const ext = fmExt(entry.name);
  if (IMAGE_EXTS.has(ext) && ext !== 'svg') return fmPreviewImage(fullPath, entry.name);
  if (TEXT_EXTS.has(ext) || entry.size === 0) return fmOpenEditor(fullPath, entry.name, entry.size);
  return fmPreviewUnavailable(fullPath, entry.name);
}

function fmPreviewImage(fullPath, name) {
  document.getElementById('previewTitle').textContent = name;
  document.getElementById('previewBody').innerHTML = `<img class="fm-preview-img" src="${API_BASE}/download?path=${encodeURIComponent(fullPath)}" alt="${escHtml(name)}">`;
  document.getElementById('previewDownloadBtn').onclick = () => fmDownload(fullPath);
  openModal('modalPreview');
}
function fmPreviewUnavailable(fullPath, name) {
  document.getElementById('previewTitle').textContent = name;
  document.getElementById('previewBody').innerHTML = `
    <div style="padding:30px 10px;">
      ${svg('i-file', 40)}
      <div style="margin-top:12px; color:var(--text-secondary); font-size:14px;">Preview unavailable for this file type.</div>
    </div>`;
  document.getElementById('previewDownloadBtn').onclick = () => fmDownload(fullPath);
  openModal('modalPreview');
}

function fmDownload(fullPath) {
  const a = document.createElement('a');
  a.href = API_BASE + '/download?path=' + encodeURIComponent(fullPath);
  a.download = fullPath.split('/').pop();
  document.body.appendChild(a);
  a.click();
  a.remove();
}
function fmBulkDownload() {
  const dirEntries = fmState.entries.filter(e => fmState.selected.has(e.name) && e.type === 'directory');
  if (dirEntries.length > 0) {
    showToast('Folders can\'t be downloaded directly — compress them first.', 'warning');
  }
  fmState.entries.filter(e => fmState.selected.has(e.name) && e.type !== 'directory').forEach((e) => {
    fmDownload(fmJoin(fmState.path, e.name));
  });
}

// ---------------------------------------------------------------
// Built-in editor (CodeMirror)
// ---------------------------------------------------------------
let cmEditor = null;
let editorState = { path: null, originalContent: '', dirty: false };

const MODE_MAP = {
  js: 'javascript', mjs: 'javascript', cjs: 'javascript', jsx: 'javascript', ts: 'javascript', tsx: 'javascript', json: { name: 'javascript', json: true },
  py: 'python', sh: 'shell', bash: 'shell', zsh: 'shell',
  yml: 'yaml', yaml: 'yaml', xml: 'xml', html: 'htmlmixed', htm: 'htmlmixed',
  css: 'css', scss: 'css', md: 'markdown', markdown: 'markdown', sql: 'sql',
  c: 'clike', h: 'clike', cpp: 'clike', hpp: 'clike', java: 'clike', php: 'clike',
  toml: 'toml', ini: 'properties', conf: 'properties', cfg: 'properties', properties: 'properties',
  env: 'properties', log: null, txt: null
};
function fmModeFor(name) {
  const ext = fmExt(name);
  if (ext in MODE_MAP) return MODE_MAP[ext] || null;
  return null;
}

async function fmOpenEditor(fullPath, name, size) {
  try {
    const data = await fmApi('/raw?path=' + encodeURIComponent(fullPath));
    document.getElementById('editorTitle').textContent = name;
    document.getElementById('editorPath').textContent = fullPath;
    document.getElementById('editorDirtyBadge').style.display = 'none';
    document.getElementById('editorReadOnly').checked = false;
    editorState = { path: fullPath, originalContent: data.content, dirty: false };

    const host = document.getElementById('editorHost');
    host.innerHTML = '';
    cmEditor = CodeMirror(host, {
      value: data.content,
      mode: fmModeFor(name),
      theme: 'material-darker',
      lineNumbers: true,
      lineWrapping: false,
      indentUnit: 2,
      tabSize: 2,
      readOnly: false
    });
    cmEditor.on('change', () => {
      editorState.dirty = cmEditor.getValue() !== editorState.originalContent;
      document.getElementById('editorDirtyBadge').style.display = editorState.dirty ? 'inline-flex' : 'none';
    });
    openModal('modalEditor');
    setTimeout(() => cmEditor.refresh(), 50);
  } catch (e) {
    if (e.code === 'TOO_LARGE') {
      showToast(e.message, 'warning');
      return fmPreviewUnavailable(fullPath, name);
    }
    showToast(e.message || 'Could not open file', 'error');
  }
}
function fmToggleReadOnly() {
  if (cmEditor) cmEditor.setOption('readOnly', document.getElementById('editorReadOnly').checked);
}
async function fmSaveFile() {
  if (!editorState.path || !cmEditor) return;
  const content = cmEditor.getValue();
  try {
    await fetch(API_BASE + '/save?path=' + encodeURIComponent(editorState.path), {
      method: 'PUT',
      headers: { 'Content-Type': 'text/plain;charset=utf-8' },
      body: content
    }).then(async (res) => {
      let data; try { data = await res.json(); } catch (e) { data = {}; }
      if (!res.ok) throw new Error(data.error || 'Save failed');
      return data;
    });
    editorState.originalContent = content;
    editorState.dirty = false;
    document.getElementById('editorDirtyBadge').style.display = 'none';
    showToast('File saved', 'success');
    fmRefresh();
  } catch (e) {
    showToast(e.message || 'Could not save file', 'error');
  }
}
async function fmCloseEditor() {
  if (editorState.dirty) {
    const ok = await confirmAction('You have unsaved changes. Discard them?', 'Discard changes?', 'danger');
    if (!ok) return;
  }
  closeModal('modalEditor');
  cmEditor = null;
  editorState = { path: null, originalContent: '', dirty: false };
}

