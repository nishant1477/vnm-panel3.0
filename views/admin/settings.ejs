                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" style="color: var(--accent-orange);"><rect x="4" y="4" width="16" height="16" rx="2"/><path d="M9 9h6v6H9z"/></svg>
                <div style="font-size: 12px; font-weight: 600; color: var(--accent-orange); margin-top: 6px;">VM Isolation</div>
                <div style="font-size: 11px; color: var(--text-muted);">Only own VMs</div>
              </div>
