<!-- MODAL with svg icon -->
<div class="modal-overlay" id="changePasswordModal">
  <div class="modal">
    <div class="modal-header">
      <div class="modal-title" style="display: flex; align-items: center; gap: 8px;"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 2l-2 2m-7.6 7.6a5.5 5.5 0 1 0-7.8 7.8 5.5 5.5 0 0 0 7.8-7.8z"/></svg> Change Password</div>
      <button class="modal-close" onclick="closeModal('changePasswordModal')"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg></button>
    </div>
    <div class="modal-body">
      <div id="pwChangeAlert" style="display: none; margin-bottom: 14px;"></div>
      <div class="form-group"><label class="form-label">New Password</label><input type="password" class="form-control" id="newPw" placeholder="Min 8 characters"></div>
      <div class="form-group" style="margin-bottom: 0;"><label class="form-label">Confirm Password</label><input type="password" class="form-control" id="confirmPw" placeholder="Repeat password"></div>
    </div>
    <div class="modal-footer">
      <button class="btn btn-ghost" onclick="closeModal('changePasswordModal')">Cancel</button>
      <button class="btn btn-primary" onclick="changePassword()">Update Password</button>
    </div>
  </div>
</div>

<script>
(function() {
  // Tab switching logic - FIXED
  window.switchTab = function(tab) {
    const tabs = ['general', 'branding', 'security', 'system', 'discord', 'about'];
    
    // Update all tab buttons
    document.querySelectorAll('.tab-btn').forEach((btn, idx) => {
      btn.classList.toggle('active', tabs[idx] === tab);
    });
    
    // Hide all tab panes and show the selected one
    document.querySelectorAll('.tab-pane').forEach(pane => {
      pane.style.display = pane.id === `tab-${tab}` ? 'block' : 'none';
      pane.classList.toggle('active', pane.id === `tab-${tab}`);
    });
    
    // Load tab-specific data
    if (tab === 'system') loadSystemStats();
    if (tab === 'discord') loadDiscordSettings();
  };

  // Get icon URL inputs - consolidated
  function getIconUrlInput() {
    // Use the Branding tab input with unique ID
    return document.getElementById('setting_site_icon_url_branding') || document.getElementById('setting_site_icon_url');
  }

  // Load settings
  async function loadSettings() {
    try {
      const res = await fetch('/api/settings');
      if (!res.ok) return;
      const settings = await res.json();
      Object.entries(settings).forEach(([key, value]) => {
        const els = document.querySelectorAll(`[data-key="${key}"]`);
        els.forEach(el => { if (el) el.value = value || ''; });
      });
      updateBrandPreview();
    } catch(e) {
      console.error('Failed to load settings:', e);
    }
  }

  window.updateBrandPreview = function() {
    const siteName = document.getElementById('setting_site_name')?.value || 'VNM Panel';
    const siteDesc = document.getElementById('setting_site_description')?.value || 'Virtual Machine Management System';
    const siteIconUrl = getIconUrlInput()?.value || '';
    
    const pi = document.getElementById('previewIcon');
    const pif = document.getElementById('previewIconFallback');
    const pt = document.getElementById('previewTitle');
    const pd = document.getElementById('previewDesc');
    
    if (siteIconUrl) {
      if (pi) {
        pi.src = siteIconUrl;
        pi.style.display = 'block';
      }
      if (pif) pif.style.display = 'none';
    } else {
      if (pi) pi.style.display = 'none';
      if (pif) pif.style.display = 'block';
    }
    if (pt) pt.textContent = siteName;
    if (pd) pd.textContent = siteDesc;
  };

  // Listeners on all relevant inputs
  document.addEventListener('DOMContentLoaded', () => {
    ['setting_site_name', 'setting_site_description', 'setting_site_icon_url_branding', 'setting_panel_title', 'setting_panel_description'].forEach(id => {
      const el = document.getElementById(id);
      if (el) el.addEventListener('input', updateBrandPreview);
    });
    loadSettings();
    // Set all tab panes to display:none except first one
    document.querySelectorAll('.tab-pane').forEach((pane, idx) => {
      pane.style.display = idx === 0 ? 'block' : 'none';
    });
  });

  window.saveAllSettings = async function() {
    const settings = {};
    document.querySelectorAll('[data-key]').forEach(el => {
      const key = el.getAttribute('data-key');
      if (key && el.value) settings[key] = el.value;
    });
    const alert = document.getElementById('settingsAlert');
    try {
      let allSaved = 0;
      
      // Save regular settings
      if (Object.keys(settings).length > 0) {
        const res = await fetch('/api/settings', { 
          method: 'PUT', 
          headers: {'Content-Type': 'application/json'}, 
          body: JSON.stringify(settings) 
        });
        const data = await res.json();
        if (res.ok && data.success) {
          allSaved += data.saved || 0;
        } else {
          throw new Error(data.errors ? data.errors.map(e=>e.error).join(', ') : 'Save failed');
        }
      }
      
      // Save Discord settings
      await saveDiscordSettings();
      
      alert.className = 'alert alert-success';
      alert.innerHTML = `<span class="alert-icon">✅</span><span>All settings saved</span>`;
      alert.style.display = 'flex';
      if (window.showToast) showToast('All settings saved', 'success');
    } catch(e) {
      alert.className = 'alert alert-error';
      alert.innerHTML = `<span class="alert-icon">❌</span><span>${e.message}</span>`;
      alert.style.display = 'flex';
      if (window.showToast) showToast('Failed: ' + e.message, 'error');
    }
    setTimeout(() => alert.style.display = 'none', 4000);
  };

  window.loadSystemStats = async function() {
    const el = document.getElementById('systemLiveStats');
    if (!el) return;
    try {
      const res = await fetch('/api/vms');
      const vms = res.ok ? await res.json() : [];
      const running = vms.filter(v => v.status === 'running').length;
      el.innerHTML = `
        <div style="display: grid; gap: 8px;">
          <div style="display: flex; justify-content: space-between; padding: 8px 0; border-bottom: 1px solid var(--border-subtle);"><span style="font-size: 12px; color: var(--text-muted);">Total VMs</span><span style="font-weight: 600;">${vms.length}</span></div>
          <div style="display: flex; justify-content: space-between; padding: 8px 0; border-bottom: 1px solid var(--border-subtle);"><span style="font-size: 12px; color: var(--text-muted);">Running VMs</span><span style="color: var(--accent-green); font-weight: 600;">${running}</span></div>
          <div style="display: flex; justify-content: space-between; padding: 8px 0;"><span style="font-size: 12px; color: var(--text-muted);">Panel Status</span><span style="color: var(--accent-green);">🟢 Online</span></div>
        </div>`;
    } catch(e) {
      el.innerHTML = `<div style="color: var(--text-muted); font-size: 12px;">Could not load stats</div>`;
    }
  };

  window.stopAllVMs = async function() {
    if (window.confirmAction) {
      const confirmed = await confirmAction('Force stop ALL running VMs?', '⚠️ Stop All VMs');
      if (!confirmed) return;
    } else {
      if (!confirm('Stop all running VMs?')) return;
    }
    try {
      const res = await fetch('/api/vms');
      const vms = await res.json();
      const running = vms.filter(v => v.status === 'running');
      if (running.length === 0) { 
        if (window.showToast) showToast('No running VMs', 'info'); 
        return; 
      }
      let stopped = 0;
      for (const vm of running) { 
        try { 
          await fetch(`/api/vms/${vm.vm_id}/stop`, {method:'POST'}); 
          stopped++; 
        } catch(e){}
      }
      if (window.showToast) showToast(`Stopped ${stopped} VM(s)`, 'success');
    } catch(e) { 
      if (window.showToast) showToast('Error: ' + e.message, 'error'); 
    }
  };

  // Change password - FIXED to show validation
  window.changePassword = async function() {
    const pw = document.getElementById('newPw')?.value;
    const confirmPw = document.getElementById('confirmPw')?.value;
    const alert = document.getElementById('pwChangeAlert');
    
    if (!pw || pw.length < 8) {
      alert.className = 'alert alert-error'; 
      alert.innerHTML = '<span class="alert-icon">❌</span><span>Min 8 characters required</span>'; 
      alert.style.display = 'flex'; 
      return;
    }
    if (pw !== confirmPw) {
      alert.className = 'alert alert-error'; 
      alert.innerHTML = '<span class="alert-icon">❌</span><span>Passwords do not match</span>'; 
      alert.style.display = 'flex'; 
      return;
    }
    
    // Show pending state
    alert.className = 'alert alert-info';
    alert.innerHTML = '<span class="alert-icon">⏳</span><span>Updating password...</span>';
    alert.style.display = 'flex';
    
    try {
      // Note: Change password endpoint not yet implemented in backend
      // Placeholder for future implementation
      alert.className = 'alert alert-warning';
      alert.innerHTML = '<span class="alert-icon">⚠️</span><span>Change password API endpoint not yet implemented</span>';
      alert.style.display = 'flex';
    } catch(e) {
      alert.className = 'alert alert-error';
      alert.innerHTML = `<span class="alert-icon">❌</span><span>${e.message}</span>`;
      alert.style.display = 'flex';
    }
  };

  // Discord Settings
  window.loadDiscordSettings = async function() {
    try {
      const res = await fetch('/api/admin/discord-settings');
      if (!res.ok) return;
      const settings = await res.json();
      
      document.getElementById('discord_enabled').checked = settings.enabled ? true : false;
      document.getElementById('discord_client_id').value = settings.client_id || '';
      document.getElementById('discord_client_secret').value = settings.client_secret || '';
      document.getElementById('discord_redirect_uri').value = settings.redirect_uri || '';
      document.getElementById('discord_bot_token').value = settings.bot_token || '';
      document.getElementById('discord_guild_id').value = settings.guild_id || '';
      document.getElementById('discord_auto_role_id').value = settings.auto_role_id || '';
      
      updateDiscordFormState();
    } catch(e) {
      console.error('Failed to load Discord settings:', e);
    }
  };

  window.updateDiscordFormState = function() {
    const enabled = document.getElementById('discord_enabled').checked;
    const credsSection = document.getElementById('discordCredsSection');
    const botSection = document.getElementById('discordBotSection');
    
    if (enabled) {
      credsSection.style.display = 'block';
      botSection.style.display = 'block';
    } else {
      credsSection.style.display = 'none';
      botSection.style.display = 'none';
    }
  };

  window.saveDiscordSettings = async function() {
    const enabled = document.getElementById('discord_enabled').checked;
    const clientId = document.getElementById('discord_client_id').value;
    const clientSecret = document.getElementById('discord_client_secret').value;
    const redirectUri = document.getElementById('discord_redirect_uri').value;
    const botToken = document.getElementById('discord_bot_token').value;
    const guildId = document.getElementById('discord_guild_id').value;
    const autoRoleId = document.getElementById('discord_auto_role_id').value;
    
    if (enabled && (!clientId || !clientSecret || !redirectUri)) {
      throw new Error('Client ID, Client Secret, and Redirect URI are required when Discord auth is enabled');
    }

    const alert = document.getElementById('settingsAlert');
    try {
      const res = await fetch('/api/admin/discord-settings', {
        method: 'PUT',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          enabled,
          client_id: clientId,
          client_secret: clientSecret,
          redirect_uri: redirectUri,
          bot_token: botToken,
          guild_id: guildId,
          auto_role_id: autoRoleId
        })
      });

      const data = await res.json();
      if (res.ok && data.success) {
        alert.className = 'alert alert-success';
        alert.innerHTML = `<span class="alert-icon">✅</span><span>Discord settings saved</span>`;
        alert.style.display = 'flex';
        if (window.showToast) showToast('Discord settings saved', 'success');
      } else {
        throw new Error(data.error || 'Failed to save Discord settings');
      }
    } catch(e) {
      alert.className = 'alert alert-error';
      alert.innerHTML = `<span class="alert-icon">❌</span><span>${e.message}</span>`;
      alert.style.display = 'flex';
      if (window.showToast) showToast('Error: ' + e.message, 'error');
    }
    setTimeout(() => alert.style.display = 'none', 4000);
  };

  // Load Discord settings on page load
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', loadDiscordSettings);
  } else {
    loadDiscordSettings();
  }

  // Modal helpers - FIXED to use correct classes
  if (!window.openModal) {
    window.openModal = (id) => {
      const modal = document.getElementById(id);
      if (modal) modal.classList.add('show');
    };
  }
  if (!window.closeModal) {
    window.closeModal = (id) => {
      const modal = document.getElementById(id);
      if (modal) modal.classList.remove('show');
    };
  }
})();
</script>
  <script src="/js/vnm-motion.js" defer></script>
</body>
</html>