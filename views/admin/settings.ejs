      <!-- SYSTEM TAB -->
      <div class="tab-pane" id="tab-system">
        <div class="card">
          <div class="card-header">
            <div class="card-title"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="4" y="4" width="16" height="16" rx="2"/><rect x="9" y="9" width="6" height="6"/><path d="M9 1v3M15 1v3M9 20v3M15 20v3M20 9h3M20 14h3M1 9h3M1 14h3"/></svg> System Information</div>
          </div>
          <div class="card-body">
            <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 20px;">
              <div>
                <div style="font-size: 11px; text-transform: uppercase; letter-spacing: 0.8px; color: var(--text-muted); margin-bottom: 12px;">Panel Info</div>
                <div style="display: grid; gap: 8px;">
                  <div style="display: flex; justify-content: space-between; padding: 8px 0; border-bottom: 1px solid var(--border-subtle);"><span style="font-size: 12px; color: var(--text-muted);">Version</span><span style="font-size: 12px; color: var(--accent-primary); font-weight: 600;">VNM V1.0.0</span></div>
                  <div style="display: flex; justify-content: space-between; padding: 8px 0; border-bottom: 1px solid var(--border-subtle);"><span style="font-size: 12px; color: var(--text-muted);">Framework</span><span style="font-size: 12px;">Express.js + EJS</span></div>
                  <div style="display: flex; justify-content: space-between; padding: 8px 0; border-bottom: 1px solid var(--border-subtle);"><span style="font-size: 12px; color: var(--text-muted);">Database</span><span style="font-size: 12px;">SQLite3</span></div>
                  <div style="display: flex; justify-content: space-between; padding: 8px 0; border-bottom: 1px solid var(--border-subtle);"><span style="font-size: 12px; color: var(--text-muted);">Hypervisor</span><span style="font-size: 12px;">QEMU/KVM</span></div>
                  <div style="display: flex; justify-content: space-between; padding: 8px 0;"><span style="font-size: 12px; color: var(--text-muted);">Cloud Init</span><span style="color: var(--accent-green);">✅ Supported</span></div>
                </div>
              </div>
              <div>
                <div style="font-size: 11px; text-transform: uppercase; letter-spacing: 0.8px; color: var(--text-muted); margin-bottom: 12px;">Live Stats</div>
                <div id="systemLiveStats">
                  <div style="text-align: center; padding: 20px;"><div class="spinner" style="margin: 0 auto;"></div></div>
                </div>
              </div>
            </div>
          </div>
        </div>
        <!-- Danger zone with svg -->
        <div class="settings-section" style="margin-top: 20px; border-color: rgba(239, 68, 68, 0.2);">
          <div class="settings-section-header">
            <span class="settings-section-icon"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"/><line x1="12" y1="9" x2="12" y2="13"/><line x1="12" y1="17" x2="12.01" y2="17"/></svg></span>
            <div><div class="settings-section-title" style="color: var(--accent-red);">Danger Zone</div></div>
          </div>
          <div class="settings-section-body">
            <div class="settings-row">
              <div class="settings-row-info"><div class="settings-row-label">Stop All VMs</div><div class="settings-row-desc">Emergency stop running virtual machines</div></div>
              <div class="settings-row-control"><button class="btn btn-danger btn-sm" onclick="stopAllVMs()" style="display: flex; align-items: center; gap: 6px;"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"/></svg> Stop All</button></div>
            </div>
          </div>
        </div>
      </div>

      <!-- ABOUT TAB with svg dynamic -->
      <div class="tab-pane" id="tab-about">
        <div class="card">
          <div class="card-body" style="text-align: center; padding: 40px;">
            <div style="font-size: 72px; margin-bottom: 20px; color: var(--accent-primary); animation: float 3s ease-in-out infinite;">
              <svg width="70" height="70" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M13 2L3 14h9l-1 8 10-12h-9l1-8z"/></svg>
            </div>
            <div style="font-size: 28px; font-weight: 800;">VNM Panel</div>
            <div style="font-size: 14px; color: var(--text-muted);">Professional VM Management Platform</div>
            <div style="font-size: 13px; color: var(--accent-primary); font-weight: 600; margin-bottom: 24px;"><%= panelVersion %></div>
            <div style="max-width: 500px; margin: 0 auto 28px; font-size: 13px; color: var(--text-muted); line-height: 1.7;">QEMU/KVM platform with cloud-init, monitoring and multi-user access.</div>
            <div style="display: grid; grid-template-columns: repeat(3, 1fr); gap: 12px; max-width: 500px; margin: 0 auto 28px;">
              <div style="padding: 14px; background: rgba(99,102,241,0.06); border-radius: 10px;"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="4" y="4" width="16" height="16" rx="2"/><path d="M9 9h6v6H9z"/></svg><div style="font-size: 11px; margin-top: 6px;">VM Mgmt</div></div>
              <div style="padding: 14px; background: rgba(16,185,129,0.06); border-radius: 10px;"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M17.5 19a4.5 4.5 0 1 0-4.5-4.5"/><path d="M20 8V6a2 2 0 0 0-2-2H6a2 2 0 0 0-2 2v12a2 2 0 0 0 2 2h2"/><path d="M16 9h2"/></svg><div style="font-size: 11px;">Cloud Init</div></div>
              <div style="padding: 14px; background: rgba(245,158,11,0.06); border-radius: 10px;"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg><div style="font-size: 11px;">RBAC</div></div>
            </div>
            <div style="font-size: 12px; color: var(--text-muted);">&copy; 2026 <b>Made by Immortal</b> · Built with ❤️</div>
