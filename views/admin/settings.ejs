<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=yes">
  <meta name="theme-color" content="#0a0a0f">
  <title><%= title || 'Settings - VNM Panel' %></title>
  <link rel="icon" href="<%= siteLogo %>" type="image/png">
  <!-- Font Awesome removed – replaced with inline SVGs (no external icon dependency) -->
  <link rel="stylesheet" href="/css/admin.css">
  <link rel="stylesheet" href="/css/vnm-motion.css">
  <!-- dynamic accent pulse (inline micro-interaction without extra css file) -->
  <style>
    /* subtle dynamic touch – only micro-animation, no design css (everything else uses admin.css) */
    @keyframes subtlePulse { 0%{opacity:.7} 50%{opacity:1} 100%{opacity:.7} }
    .dynamic-pulse { animation: subtlePulse 2.8s ease-in-out infinite; }
    .hover-lift { transition: transform 0.2s ease, box-shadow 0.2s ease; }
    .hover-lift:hover { transform: translateY(-2px); box-shadow: 0 8px 16px rgba(0,0,0,0.08); }
    .badge-dot { display: inline-block; width: 8px; height: 8px; border-radius: 50%; background: #10b981; margin-right: 6px; }
    
    /* Mobile responsive fixes */
    .tabs { display: flex; overflow-x: auto; -webkit-overflow-scrolling: touch; }
    .tab-btn { white-space: nowrap; flex-shrink: 0; }
    
    .settings-row { display: flex; align-items: flex-start; justify-content: space-between; gap: 20px; padding: 16px 0; border-bottom: 1px solid var(--border-subtle); flex-wrap: wrap; }
    .settings-row-info { flex: 1; min-width: 200px; }
    .settings-row-control { flex: 1; min-width: 220px; }
    
    @media (max-width: 768px) {
      .settings-row { flex-direction: column; gap: 12px; }
      .settings-row-control { width: 100%; }
      .page-header { flex-direction: column !important; gap: 12px; }
      .page-actions { width: 100%; }
      .tabs { gap: 4px; }
      .tab-btn { font-size: 12px; padding: 8px 12px !important; }
      .settings-section-body { padding: 12px 0 !important; }
      .card { margin-bottom: 16px !important; }
      
      /* Form controls full width on mobile */
      .form-control { width: 100%; }
      .form-group { margin-bottom: 12px !important; }
      
      /* Modal adjustments */
      .modal { width: 95vw !important; max-width: 95vw !important; }
    }
    
    @media (max-width: 480px) {
      .page-title { font-size: 18px !important; }
      .tab-btn { font-size: 11px; padding: 6px 10px !important; }
      .settings-row-label { font-size: 13px; }
      .settings-row-desc { font-size: 11px; }
      .tabs { gap: 2px; }
    }
  </style>
</head>
<body>
<div class="admin-wrapper">
  <%- include('../partials/admin/sidebar') %>

  <div class="admin-main">
    <%- include('../partials/admin/header') %>

    <div class="admin-content">

      <!-- Page Header (refined with svg + dynamic microcopy) -->
      <div class="page-header">
        <div class="page-title-section">
          <h1 class="page-title" style="display: flex; align-items: center; gap: 10px;">
            <span class="title-icon" style="color: var(--accent-primary);">
              <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                <circle cx="12" cy="12" r="3"></circle><path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 1 1-2.83 2.83l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 1 1-4 0v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 1 1-2.83-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 1 1 0-4h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 1 1 2.83-2.83l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 1 1 4 0v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 1 1 2.83 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 1 1 0 4h-.09a1.65 1.65 0 0 0-1.51 1z"></path>
              </svg>
            </span>
            System Settings
          </h1>
          <p class="page-subtitle" style="display: flex; align-items: center; gap: 8px;">
            <span class="dynamic-pulse" style="background: var(--accent-green); width: 8px; height: 8px; border-radius: 50%;"></span>
            Configure VNM Panel preferences · live sync
          </p>
        </div>
        <div class="page-actions">
          <button class="btn btn-primary hover-lift" onclick="saveAllSettings()" style="display: flex; align-items: center; gap: 8px;">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M19 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11l5 5v11a2 2 0 0 1-2 2z"></path>
              <polyline points="17 21 17 13 7 13 7 21"></polyline><polyline points="7 3 7 8 15 8"></polyline>
            </svg>
            Save All Settings
          </button>
        </div>
      </div>

      <div id="settingsAlert" style="display: none; margin-bottom: 16px;"></div>

      <!-- Modern Tabs with SVG icons (all icons embedded) -->
      <div class="tabs" style="gap: 6px; flex-wrap: wrap;">
        <button class="tab-btn active" onclick="switchTab('general')" style="display: flex; align-items: center; gap: 6px;">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><line x1="2" y1="12" x2="22" y2="12"/><path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"/></svg>
          General
        </button>
        <button class="tab-btn" onclick="switchTab('branding')" style="display: flex; align-items: center; gap: 6px;">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 19l7-7 3 3-7 7-3-3z"/><path d="M18 13l-1.5-7.5L2 2l3.5 14.5L13 18l5-5z"/><path d="M2 2l7.586 7.586"/><circle cx="11" cy="11" r="2"/></svg>
          Branding
        </button>
        <button class="tab-btn" onclick="switchTab('security')" style="display: flex; align-items: center; gap: 6px;">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/><path d="M9 12l2 2 4-4"/></svg>
          Security
        </button>
        <button class="tab-btn" onclick="switchTab('system')" style="display: flex; align-items: center; gap: 6px;">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="4" y="4" width="16" height="16" rx="2"/><rect x="9" y="9" width="6" height="6"/><path d="M9 1v3M15 1v3M9 20v3M15 20v3M20 9h3M20 14h3M1 9h3M1 14h3"/></svg>
          System
        </button>
        <button class="tab-btn" onclick="switchTab('discord')" style="display: flex; align-items: center; gap: 6px;">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" style="color: #5865F2;">
            <path d="M20.317 4.3632a19.791 19.791 0 00-4.885-1.515a.074.074 0 00-.079.0366c-.211.3648-.444.8384-.607 1.2144a18.27 18.27 0 00-5.487 0c-.163-.3776-.385-.8496-.607-1.2144a.077.077 0 00-.079-.0365c-1.751.289-3.436.906-4.884 1.515a.07.07 0 00-.032.0277C1.533 8.93.013 12.3928 1.191 15.7839a.076.076 0 00.029.0335c2.409 1.796 4.776 2.894 7.102 3.622a.077.077 0 00.084-.0276c.462-.6392.873-1.3135 1.226-2.0137a.073.073 0 00-.041-.1008c-.663-.2565-1.289-.5666-1.88-.9235a.075.075 0 01-.008-.1242c.126-.0947.252-.1938.372-.2923a.072.072 0 01.075-.0102c3.928 1.7898 8.183 1.7898 12.061 0a.073.073 0 01.075.009c.12.099.246.1991.373.2924a.075.075 0 01-.006.1242c-.59.3569-1.216.6674-1.88.9235a.073.073 0 00-.041.1008c.353.6994.764 1.3745 1.226 2.0137a.076.076 0 00.084.0276c2.327-.7285 4.694-1.8386 7.102-3.6221a.077.077 0 00.03-.0334c1.278-3.4668-.213-6.9301-1.798-9.7839a.070.070 0 00-.031-.0277zM8.02 13.2823c-.842 0-1.54-.7734-1.54-1.7244c0-.951.686-1.7244 1.54-1.7244c.856 0 1.551.7734 1.54 1.7244c0 .951-.686 1.7244-1.54 1.7244zm7.973 0c-.842 0-1.54-.7734-1.54-1.7244c0-.951.686-1.7244 1.54-1.7244c.856 0 1.551.7734 1.54 1.7244c0 .951-.684 1.7244-1.54 1.7244z"/>
          </svg>
          Discord
        </button>
        <button class="tab-btn" onclick="switchTab('about')" style="display: flex; align-items: center; gap: 6px;">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><path d="M12 16v-4M12 8h.01"/></svg>
          About
        </button>
      </div>

      <!-- DISCORD TAB -->
      <div class="tab-pane" id="tab-discord">
        <!-- Discord Auth Enable/Disable -->
        <div class="settings-section">
          <div class="settings-section-header">
            <span class="settings-section-icon"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg></span>
            <div><div class="settings-section-title">Discord Authentication</div></div>
          </div>
          <div class="settings-section-body">
            <div class="settings-row">
              <div class="settings-row-info">
                <div class="settings-row-label">Enable Discord Login</div>
                <div class="settings-row-desc">Allow users to login with their Discord account</div>
              </div>
              <div class="settings-row-control">
                <label class="toggle-switch">
                  <input type="checkbox" class="toggle-input" id="discord_enabled" onchange="updateDiscordFormState()">
                  <div class="toggle-track"><div class="toggle-thumb"></div></div>
                </label>
              </div>
            </div>
          </div>
        </div>

        <!-- Discord OAuth Credentials -->
        <div class="settings-section" id="discordCredsSection" style="display: none;">
          <div class="settings-section-header">
            <span class="settings-section-icon"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 2l-2 2m-7.6 7.6a5.5 5.5 0 1 0-7.8 7.8 5.5 5.5 0 0 0 7.8-7.8z"/></svg></span>
            <div><div class="settings-section-title">OAuth Credentials</div></div>
          </div>
          <div class="settings-section-body">
            <div class="settings-row">
              <div class="settings-row-info">
                <div class="settings-row-label">Client ID</div>
                <div class="settings-row-desc">From Discord Developer Portal</div>
              </div>
              <div class="settings-row-control">
                <input type="text" class="form-control" id="discord_client_id" placeholder="Your Discord Application Client ID">
              </div>
            </div>
            <div class="settings-row">
              <div class="settings-row-info">
                <div class="settings-row-label">Client Secret</div>
                <div class="settings-row-desc">From Discord Developer Portal (keep secure!)</div>
              </div>
              <div class="settings-row-control">
                <input type="password" class="form-control" id="discord_client_secret" placeholder="Your Discord Application Client Secret">
              </div>
            </div>
            <div class="settings-row">
              <div class="settings-row-info">
                <div class="settings-row-label">Redirect URI</div>
                <div class="settings-row-desc">OAuth2 callback URL for Discord</div>
              </div>
              <div class="settings-row-control">
                <input type="text" class="form-control" id="discord_redirect_uri" placeholder="https://yourserver.com/auth/discord/callback">
              </div>
            </div>
          </div>
        </div>

        <!-- Discord Bot Settings (Optional) -->
        <div class="settings-section" id="discordBotSection" style="display: none;">
          <div class="settings-section-header">
            <span class="settings-section-icon"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="3"/><path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 1 1-2.83 2.83l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 1 1-4 0v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 1 1-2.83-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 1 1 0-4h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 1 1 2.83-2.83l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 1 1 4 0v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 1 1 2.83 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 1 1 0 4h-.09a1.65 1.65 0 0 0-1.51 1z"/></svg></span>
            <div><div class="settings-section-title">Bot Settings (Optional)</div></div>
          </div>
          <div class="settings-section-body">
            <div class="settings-row">
              <div class="settings-row-info">
                <div class="settings-row-label">Bot Token</div>
                <div class="settings-row-desc">For automatic role assignment and server features</div>
              </div>
              <div class="settings-row-control">
                <input type="password" class="form-control" id="discord_bot_token" placeholder="Your Discord Bot Token (optional)">
              </div>
            </div>
            <div class="settings-row">
              <div class="settings-row-info">
                <div class="settings-row-label">Guild ID (Server ID)</div>
                <div class="settings-row-desc">Discord server where users will be added</div>
              </div>
              <div class="settings-row-control">
                <input type="text" class="form-control" id="discord_guild_id" placeholder="Your Discord Server ID (optional)">
              </div>
            </div>
            <div class="settings-row">
              <div class="settings-row-info">
                <div class="settings-row-label">Auto Role ID</div>
                <div class="settings-row-desc">Automatic role assigned to new members</div>
              </div>
              <div class="settings-row-control">
                <input type="text" class="form-control" id="discord_auto_role_id" placeholder="Discord Role ID for auto-assignment (optional)">
              </div>
            </div>
          </div>
        </div>

        <!-- Help Section -->
        <div class="card">
          <div class="card-header">
            <div class="card-title"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><path d="M12 16v-4M12 8h.01"/></svg> Discord Setup Guide</div>
          </div>
          <div class="card-body">
            <div style="font-size: 13px; line-height: 1.8; color: var(--text-secondary);">
              <div style="margin-bottom: 16px;">
                <div style="font-weight: 600; margin-bottom: 8px;">How to setup Discord OAuth:</div>
                <ol style="margin: 0; padding-left: 20px;">
                  <li style="margin-bottom: 6px;">Go to <a href="https://discord.com/developers/applications" target="_blank" style="color: #5865F2; text-decoration: underline;">Discord Developer Portal</a></li>
                  <li style="margin-bottom: 6px;">Create a new application</li>
                  <li style="margin-bottom: 6px;">Go to "OAuth2" → "General" and copy the Client ID and Client Secret</li>
                  <li style="margin-bottom: 6px;">Set Redirect URL in OAuth2 section to match your Redirect URI above</li>
                  <li style="margin-bottom: 6px;">Enter the credentials here and enable Discord Login</li>
                </ol>
              </div>
              <div style="padding: 12px; background: rgba(99, 102, 241, 0.06); border-left: 3px solid #6366f1; border-radius: 4px;">
                <strong style="color: #6366f1;">Redirect URI Example:</strong><br>
                <code style="font-size: 12px;">https://yourserver.com/auth/discord/callback</code>
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- GENERAL TAB -->
      <div class="tab-pane active" id="tab-general">
        <!-- Site branding section with SVG -->
        <div class="settings-section">
          <div class="settings-section-header">
            <span class="settings-section-icon"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 2L2 7l10 5 10-5-10-5z"/><path d="M2 17l10 5 10-5"/><path d="M2 12l10 5 10-5"/></svg></span>
            <div>
              <div class="settings-section-title">Site Branding</div>
            </div>
          </div>
          <div class="settings-section-body">
            <div class="settings-row">
              <div class="settings-row-info">
                <div class="settings-row-label">Site Name</div>
                <div class="settings-row-desc">The main title shown throughout the application</div>
              </div>
              <div class="settings-row-control">
                <input type="text" class="form-control" id="setting_site_name" data-key="site_name" placeholder="VNM Panel">
              </div>
            </div>
            <div class="settings-row">
              <div class="settings-row-info">
                <div class="settings-row-label">Site Description</div>
                <div class="settings-row-desc">Short description shown in login page and meta tags</div>
              </div>
              <div class="settings-row-control">
                <input type="text" class="form-control" id="setting_site_description" data-key="site_description" placeholder="Virtual Machine Management System">
              </div>
            </div>
            <div class="settings-row">
              <div class="settings-row-info">
                <div class="settings-row-label">Site Icon URL</div>
                <div class="settings-row-desc">Full URL to your site icon (PNG, SVG, JPG). Example: /images/icon.png</div>
              </div>
              <div class="settings-row-control">
                <input type="text" class="form-control" id="setting_site_icon_url" data-key="site_icon_url" placeholder="https://example.com/icon.png">
              </div>
            </div>
          </div>
        </div>

        <!-- General config -->
        <div class="settings-section">
          <div class="settings-section-header">
            <span class="settings-section-icon"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="3"/><path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 1 1-2.83 2.83l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 1 1-4 0v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 1 1-2.83-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 1 1 0-4h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 1 1 2.83-2.83l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 1 1 4 0v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 1 1 2.83 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 1 1 0 4h-.09a1.65 1.65 0 0 0-1.51 1z"/></svg></span>
            <div><div class="settings-section-title">General Configuration</div></div>
          </div>
          <div class="settings-section-body">
            <div class="settings-row">
              <div class="settings-row-info"><div class="settings-row-label">Panel Title</div><div class="settings-row-desc">The name shown in browser title</div></div>
              <div class="settings-row-control"><input type="text" class="form-control" id="setting_panel_title" data-key="panel_title" placeholder="VNM Panel V1.0"></div>
            </div>
            <div class="settings-row">
              <div class="settings-row-info"><div class="settings-row-label">Panel Description</div><div class="settings-row-desc">Login page subtitle</div></div>
              <div class="settings-row-control"><input type="text" class="form-control" id="setting_panel_description" data-key="panel_description" placeholder="Professional VM Management"></div>
            </div>
            <div class="settings-row">
              <div class="settings-row-info"><div class="settings-row-label">Panel Version</div><div class="settings-row-desc">Current version identifier</div></div>
              <div class="settings-row-control"><input type="text" class="form-control" id="setting_panel_version" data-key="panel_version" placeholder="V1.0"></div>
            </div>
          </div>
        </div>

        <!-- Session -->
        <div class="settings-section">
          <div class="settings-section-header">
            <span class="settings-section-icon"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg></span>
            <div><div class="settings-section-title">Session & Access</div></div>
          </div>
          <div class="settings-section-body">
            <div class="settings-row">
              <div class="settings-row-info"><div class="settings-row-label">Session Timeout (hours)</div><div class="settings-row-desc">Auto logout interval</div></div>
              <div class="settings-row-control"><input type="number" class="form-control" id="setting_session_timeout" data-key="session_timeout" min="1" max="720" placeholder="24"></div>
            </div>
            <div class="settings-row">
              <div class="settings-row-info"><div class="settings-row-label">Max Concurrent Sessions</div><div class="settings-row-desc">Per user limit</div></div>
              <div class="settings-row-control"><input type="number" class="form-control" id="setting_max_sessions" data-key="max_sessions" min="1" max="100" placeholder="10"></div>
            </div>
          </div>
        </div>
      </div>

      <!-- BRANDING TAB -->
      <div class="tab-pane" id="tab-branding">
        <div class="settings-section">
          <div class="settings-section-header">
            <span class="settings-section-icon"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 19l7-7 3 3-7 7-3-3z"/><path d="M18 13l-1.5-7.5L2 2l3.5 14.5L13 18l5-5z"/><circle cx="11" cy="11" r="2"/></svg></span>
            <div><div class="settings-section-title">Site Icon</div></div>
          </div>
          <div class="settings-section-body">
            <div class="settings-row">
              <div class="settings-row-info"><div class="settings-row-label">Site Icon URL</div><div class="settings-row-desc">PNG/SVG path</div></div>
              <div class="settings-row-control"><input type="text" class="form-control" id="setting_site_icon_url_branding" data-key="site_icon_url" placeholder="/public/images/logo.png"></div>
            </div>
