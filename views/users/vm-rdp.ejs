<div class="admin-wrapper">
  <%- include('../partials/users/sidebar') %>

  <div class="admin-main">
    <%- include('../partials/admin/header') %>

    <div class="admin-content" id="pageContent">
      <div style="text-align: center; padding: 80px;">
        <div class="spinner spinner-lg" style="margin: 0 auto 16px;"></div>
        <div style="color: var(--text-muted);">Loading Remote Desktop...</div>
      </div>
    </div>

    <%- include('../partials/admin/footer') %>
  </div>
</div>

<style>
  .rdp-grid { display:grid; grid-template-columns:minmax(0,1.25fr) minmax(0,1fr); gap:20px; align-items:start; }
  @media (max-width: 1050px) { .rdp-grid { grid-template-columns:minmax(0,1fr); } }
  .rdp-badge { display:inline-flex; align-items:center; gap:6px; padding:5px 12px; border-radius:999px; font-size:11px; font-weight:700; letter-spacing:.5px; }
  .rdp-badge i { width:7px; height:7px; border-radius:50%; background:currentColor; display:inline-block; }
  .rdp-steps { list-style:none; margin:14px 0 0; padding:0; display:grid; gap:10px; }
  .rdp-steps li { display:flex; align-items:center; gap:12px; font-size:13px; color:var(--text-muted); }
  .rdp-steps .dot { width:24px; height:24px; border-radius:50%; display:inline-flex; align-items:center; justify-content:center; font-size:11px; font-weight:700; border:1px solid var(--border-subtle,rgba(255,255,255,.12)); flex-shrink:0; }
  .rdp-steps li.done { color:var(--text-primary); } .rdp-steps li.done .dot { background:rgba(16,185,129,.15); color:#10B981; border-color:rgba(16,185,129,.4); }
  .rdp-steps li.active { color:var(--text-primary); font-weight:600; } .rdp-steps li.active .dot { background:rgba(99,102,241,.18); color:#818cf8; border-color:rgba(99,102,241,.5); }
  .rdp-steps li.err .dot { background:rgba(239,68,68,.15); color:#EF4444; border-color:rgba(239,68,68,.45); }
  .rdp-kv { display:grid; grid-template-columns:130px 1fr; gap:8px 12px; font-size:13px; }
  .rdp-kv .k { color:var(--text-muted); } .rdp-kv .v { color:var(--text-primary); font-family:monospace; word-break:break-all; }
  .rdp-addr { display:flex; align-items:center; justify-content:space-between; gap:10px; padding:12px 14px; margin-top:14px; border:1px solid rgba(99,102,241,.3); border-radius:10px; background:rgba(99,102,241,.07); font-family:monospace; font-size:15px; color:var(--text-primary); }
  .rdp-tabs { display:flex; gap:6px; margin-bottom:12px; }
  .rdp-tabs button { background:transparent; border:1px solid var(--border-subtle,rgba(255,255,255,.12)); color:var(--text-muted); padding:6px 14px; border-radius:8px; cursor:pointer; font-size:12px; font-weight:600; }
  .rdp-tabs button.on { background:rgba(99,102,241,.18); color:var(--text-primary); border-color:rgba(99,102,241,.5); }
  .rdp-how ol { margin:0; padding-left:20px; display:grid; gap:8px; font-size:13px; color:var(--text-secondary,var(--text-muted)); }
  .rdp-how code { background:rgba(255,255,255,.06); padding:2px 6px; border-radius:5px; font-size:12px; word-break:break-all; }
  .rdp-note { margin-top:14px; padding:10px 12px; border-radius:8px; font-size:12px; }
  .rdp-toast { position:fixed; right:20px; bottom:20px; z-index:9999; padding:12px 16px; border-radius:10px; font-size:13px; color:#fff; background:#1f2937; border:1px solid rgba(255,255,255,.15); box-shadow:0 8px 30px rgba(0,0,0,.4); }
</style>

<script>
const vmId = <%= vmId %>;
const VM_URL = '/vm/' + vmId;
const LIST_URL = '/vms';

function svg(id, size = 14) { return `<svg width="${size}" height="${size}"><use href="#${id}"/></svg>`; }
function escHtml(s) { return String(s == null ? '' : s).replace(/[&<>"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c])); }
function toast(msg, bad) {
  const t = document.createElement('div'); t.className = 'rdp-toast'; t.textContent = msg;
  if (bad) t.style.borderColor = 'rgba(239,68,68,.6)';
  document.body.appendChild(t); setTimeout(() => t.remove(), 4500);
}

let vmInfo = null, st = null, pollTimer = null, osTab = 'windows';

const BADGES = {
  online:          ['ONLINE', '#10B981', 'rgba(16,185,129,.12)'],
  offline:         ['OFFLINE', '#94A3B8', 'rgba(148,163,184,.14)'],
  installing:      ['SETTING UP', '#818cf8', 'rgba(99,102,241,.14)'],
  waiting:         ['WAITING FOR VM', '#38bdf8', 'rgba(56,189,248,.12)'],
  pending_restart: ['RESTART REQUIRED', '#F59E0B', 'rgba(245,158,11,.14)'],
  unsupported:     ['UNSUPPORTED OS', '#EF4444', 'rgba(239,68,68,.12)'],
  error:           ['ERROR', '#EF4444', 'rgba(239,68,68,.12)'],
  disabled:        ['NOT ENABLED', '#94A3B8', 'rgba(148,163,184,.14)']
};
const badge = (s) => { const b = BADGES[s] || BADGES.disabled; return `<span class="rdp-badge" style="color:${b[1]};background:${b[2]};"><i></i>${b[0]}</span>`; };

// Which of the four setup stages the server message belongs to
function stageOf(msg) {
  const m = String(msg || '').toLowerCase();
  if (/verif/.test(m)) return 4;
  if (/allocat|activat|port forward|host port/.test(m)) return 3;
  if (/install|xrdp|desktop|xsession|os:|service|configur|apt/.test(m)) return 2;
  return 1;
}
function stepsHtml() {
  const names = ['Connect to the VM over SSH', 'Install xrdp and a desktop', (st.network === 'direct' ? 'Use the VM address (no forward needed)' : 'Open a host port and forward it'), 'Verify the RDP connection'];
  let cur = 0, errAt = 0;
  if (st.status === 'online' || st.status === 'offline' || st.status === 'pending_restart') cur = 5;
  else if (st.status === 'installing') cur = stageOf(st.message);
  else if (st.status === 'error' || st.status === 'unsupported') errAt = 1;
  return `<ul class="rdp-steps">${names.map((n, i) => {
    const idx = i + 1;
    const cls = errAt === idx ? 'err' : (idx < cur ? 'done' : (idx === cur ? 'active' : ''));
    const mark = cls === 'done' ? '✓' : (cls === 'err' ? '!' : idx);
    return `<li class="${cls}"><span class="dot">${mark}</span>${escHtml(n)}${cls === 'active' ? ' <span class="spinner" style="display:inline-block;width:12px;height:12px;margin-left:4px;"></span>' : ''}</li>`;
  }).join('')}</ul>`;
}

function connectHtml() {
  const addr = st.enabled && st.host && st.port ? `${st.host}:${st.port}` : 'ADDRESS:PORT';
  const user = st.username || 'USER';
  const how = {
    windows: `<ol>
      <li>Click <b>Download .rdp file</b> above and double-click it — or press <code>Win + R</code>, type <code>mstsc</code> and press Enter.</li>
      <li>If you used <code>mstsc</code>, enter <code>${escHtml(addr)}</code> as the <b>Computer</b>.</li>
      <li>Username <code>${escHtml(user)}</code>, then the VM's password.</li>
      <li>Accept the certificate warning (xrdp uses a self-signed certificate). If asked for a session, choose <b>Xorg</b>.</li></ol>`,
    linux: `<ol>
      <li><b>Remmina:</b> New connection → Protocol <b>RDP</b> → Server <code>${escHtml(addr)}</code> → Username <code>${escHtml(user)}</code> → Connect.</li>
      <li><b>Terminal:</b> <code>xfreerdp /v:${escHtml(addr)} /u:${escHtml(user)} /dynamic-resolution +clipboard</code></li>
      <li>Enter the VM's password, accept the certificate, choose <b>Xorg</b> if asked.</li></ol>`,
    mac: `<ol>
      <li>Install <b>Windows App</b> (or Microsoft Remote Desktop) from the App Store.</li>
      <li>Add PC → PC name <code>${escHtml(addr)}</code> → User account <code>${escHtml(user)}</code>.</li>
      <li>Or open the downloaded <b>.rdp file</b> with it. Accept the certificate, choose <b>Xorg</b> if asked.</li></ol>`
  };
  return `<div class="rdp-tabs">${[['windows', 'Windows'], ['linux', 'Linux'], ['mac', 'macOS']].map(([k, n]) => `<button class="${osTab === k ? 'on' : ''}" onclick="setOsTab('${k}')">${n}</button>`).join('')}</div><div class="rdp-how">${how[osTab]}</div>`;
}
function setOsTab(k) { osTab = k; render(); }

function render() {
  if (!st || !vmInfo) return;
  const running = st.vm_status === 'running';
  const busy = st.status === 'installing';
  const vm = vmInfo;
  const direct = st.network === 'direct';
  const canAuto = !st.enabled && !/windows/i.test(`${vm.os_type || ''} ${vm.template_type || ''}`) && String(vm.template_type || '') !== 'iso-installer';

  let actions = '';
  if (!st.enabled || st.status === 'error' || st.status === 'unsupported') {
    actions = `<button class="btn btn-primary" onclick="enableRdp()" ${(!running || busy) ? 'disabled' : ''} title="${!running ? 'Start the VM first' : ''}">${svg('i-power', 14)} ${busy ? 'Setting up…' : 'Enable RDP'}</button>`;
  } else {
    actions = `<button class="btn btn-ghost" onclick="enableRdp()" ${(!running || busy) ? 'disabled' : ''} title="Safe to repeat: checks xrdp and the forward again">${svg('i-refresh', 14)} Re-run setup</button>
               <button class="btn btn-warning" onclick="disableRdp()" ${busy ? 'disabled' : ''}>${svg('i-unlink', 14)} Disable RDP</button>`;
  }

  let msg = '';
  if (st.message && st.status !== 'online' && st.status !== 'disabled') {
    const bad = st.status === 'error' || st.status === 'unsupported';
    msg = `<div class="rdp-note" style="color:${bad ? '#EF4444' : 'var(--text-secondary,var(--text-muted))'};background:${bad ? 'rgba(239,68,68,.08)' : 'rgba(148,163,184,.10)'};">${escHtml(st.message)}</div>`;
  } else if (st.status === 'disabled') {
    msg = `<div class="rdp-note" style="background:rgba(148,163,184,.08);color:var(--text-muted);">RDP is not set up for this VM yet. ${running ? 'Click <b>Enable RDP</b>: this installs xrdp and a desktop inside the VM (Debian / Ubuntu) and gives you a connection address.' : 'Start the VM, then click <b>Enable RDP</b> — or switch on automatic setup below.'}</div>`;
  }
  const auto = canAuto ? `
    <label style="display:flex;align-items:flex-start;gap:10px;margin-top:16px;padding:12px 14px;border:1px solid var(--border-subtle,rgba(255,255,255,.12));border-radius:10px;cursor:pointer;">
      <input type="checkbox" id="autoBox" ${st.auto ? 'checked' : ''} onchange="toggleAuto(this.checked)" style="margin-top:3px;">
      <span><span style="color:var(--text-primary);font-size:13px;font-weight:600;">Set up RDP automatically</span><br>
      <span style="font-size:12px;color:var(--text-muted);">As soon as this VM is running and reachable (handy for a brand-new VM that is still doing its first boot).</span></span>
    </label>` : '';

  const statusCard = `
    <div class="card">
      <div class="card-header"><div class="card-title"><span style="color:#6366F1;display:inline-flex;">${svg('i-server', 18)}</span> Remote Desktop status</div>${badge(st.status)}</div>
      <div class="card-body">
        ${stepsHtml()}
        ${msg}
        <div style="display:flex;gap:10px;flex-wrap:wrap;margin-top:18px;">${actions}</div>
        ${auto}
      </div>
    </div>`;

  const connection = st.enabled ? `
    <div class="card" style="margin-top:20px;">
      <div class="card-header"><div class="card-title"><span style="color:#10B981;display:inline-flex;">${svg('i-link', 18)}</span> Connection</div></div>
      <div class="card-body">
        <div class="rdp-kv">
          <div class="k">Host</div><div class="v">${escHtml(st.host || '—')}</div>
          <div class="k">Port</div><div class="v">${escHtml(st.port || '—')}${direct ? ' <span style="color:var(--text-muted);font-family:inherit;">(VM\'s own address)</span>' : ''}</div>
          <div class="k">Username</div><div class="v">${escHtml(st.username || '—')}</div>
          <div class="k">Guest OS</div><div class="v">${escHtml(st.guest_os || '—')}</div>
          <div class="k">Password</div><div class="v" style="font-family:inherit;">The VM's password (not shown here)</div>
        </div>
        <div class="rdp-addr"><span id="rdpAddr">${escHtml(st.host)}:${escHtml(st.port)}</span>
          <button class="btn btn-ghost btn-sm" onclick="copyText(document.getElementById('rdpAddr').textContent, 'Address copied')">${svg('i-copy', 13)} Copy</button></div>
        <div style="display:flex;gap:10px;flex-wrap:wrap;margin-top:14px;">
          <a class="btn btn-primary btn-sm" href="/api/vms/${vmId}/rdp/file" download>${svg('i-attach', 13)} Download .rdp file</a>
          <button class="btn btn-outline btn-sm" onclick="copyText('xfreerdp /v:' + document.getElementById('rdpAddr').textContent + ' /u:${escHtml(st.username || '')} /dynamic-resolution +clipboard', 'Command copied')">${svg('i-terminal', 13)} Copy xfreerdp command</button>
        </div>
        ${st.warning ? `<div class="rdp-note" style="color:#F59E0B;background:rgba(245,158,11,.10);">⚠ ${escHtml(st.warning)}</div>` : ''}
      </div>
    </div>` : `
    <div class="card" style="margin-top:20px;">
      <div class="card-header"><div class="card-title"><span style="color:#10B981;display:inline-flex;">${svg('i-link', 18)}</span> Connection</div></div>
      <div class="card-body"><div style="font-size:13px;color:var(--text-muted);">The connection address, username and a downloadable <b>.rdp</b> file appear here once RDP is enabled.</div></div>
    </div>`;

  const right = `
    <div class="card">
      <div class="card-header"><div class="card-title"><span style="color:#EC4899;display:inline-flex;">${svg('i-info', 18)}</span> How to connect</div></div>
      <div class="card-body">${connectHtml()}</div>
    </div>
    <div class="card" style="margin-top:20px;">
      <div class="card-header"><div class="card-title"><span style="color:#F59E0B;display:inline-flex;">${svg('i-shield', 18)}</span> Good to know</div></div>
      <div class="card-body"><ul style="margin:0;padding-left:18px;display:grid;gap:8px;font-size:12px;color:var(--text-muted);">
        <li>Works for <b>Debian and Ubuntu</b> VMs. The first setup downloads packages (XFCE desktop) and can take a few minutes.</li>
        <li>${direct ? 'This VM has its own address, so RDP uses it directly on port 3389.' : 'For NAT VMs the host forwards a dedicated port (' + escHtml(st.port || '33890–34889') + ') to the VM — that TCP port must be open in the host firewall.'}</li>
        <li>Prefer a regular user over <code>root</code> for remote desktop logins.</li>
        <li>Disabling RDP releases the port; xrdp stays installed so enabling again is fast.</li>
        <li>Reinstalling the VM removes RDP — enable it again afterwards.</li>
      </ul></div>
    </div>`;

  document.getElementById('pageContent').innerHTML = `
    <div class="page-header" style="align-items:center;">
      <div style="display:flex;align-items:center;gap:14px;flex:1;min-width:0;">
        <a href="${VM_URL}" style="color:var(--text-muted);text-decoration:none;display:inline-flex;align-items:center;gap:4px;font-size:13px;flex-shrink:0;">${svg('i-back', 14)} Back to VM</a>
        <div style="min-width:0;">
          <h1 class="page-title" style="margin:0;">Remote Desktop (RDP)</h1>
          <p style="font-size:12px;color:var(--text-muted);margin-top:3px;display:flex;gap:8px;align-items:center;flex-wrap:wrap;">
            <span style="background:rgba(99,102,241,.1);color:#6366F1;padding:2px 8px;border-radius:5px;font-family:monospace;font-weight:600;">#${vm.vm_id}</span>
            <span>${escHtml(vm.vm_name)}</span><span style="opacity:.6;">·</span><span>${escHtml(vm.template_name || vm.os_type || 'Custom OS')}</span><span style="opacity:.6;">·</span>
            <span style="color:${vm.status === 'running' ? '#10B981' : '#94A3B8'};">● VM ${escHtml(vm.status)}</span>
          </p>
        </div>
      </div>
      <div style="display:flex;gap:8px;">
        <a href="${VM_URL}" class="btn btn-outline btn-sm">${svg('i-info', 13)} VM details</a>
        <a href="${VM_URL}/console" class="btn btn-ghost btn-sm">${svg('i-terminal', 13)} Console</a>
      </div>
    </div>
    <div class="rdp-grid"><div>${statusCard}${connection}</div><div>${right}</div></div>`;
}

async function loadVm() {
  const r = await fetch(`/api/vms/${vmId}`);
  if (!r.ok) throw new Error('VM not found or access denied');
  vmInfo = await r.json();
}
async function loadStatus() {
  clearTimeout(pollTimer);
  let next = 8000;
  try {
    const r = await fetch(`/api/vms/${vmId}/rdp`);
    if (r.ok) {
      st = await r.json();
      const vr = await fetch(`/api/vms/${vmId}`); if (vr.ok) vmInfo = await vr.json();
      render();
      if (st.status === 'installing') next = 2000; else if (st.status === 'waiting') next = 5000;
    }
  } catch (e) { /* transient */ }
  pollTimer = setTimeout(loadStatus, next);
}
async function post(path, body) {
  const r = await fetch(`/api/vms/${vmId}/rdp/${path}`, { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(body || {}) });
  const j = await r.json().catch(() => ({}));
  return { ok: r.ok, j };
}
async function enableRdp() {
  const { ok, j } = await post('enable');
  toast(ok ? 'RDP setup started — this can take a few minutes on a fresh VM' : (j.error || 'Could not enable RDP'), !ok);
  loadStatus();
}
async function disableRdp() {
  if (!confirm('Disable RDP for this VM? The host port is released. xrdp stays installed in the VM.')) return;
  const { ok, j } = await post('disable');
  toast(ok ? 'RDP disabled' : (j.error || 'Could not disable RDP'), !ok);
  loadStatus();
}
async function toggleAuto(on) {
  const { ok, j } = await post('auto', { enabled: !!on });
  toast(ok ? (on ? 'RDP will be set up automatically' : 'Automatic setup turned off') : (j.error || 'Could not change the setting'), !ok);
  loadStatus();
}
function copyText(t, okMsg) { if (navigator.clipboard) navigator.clipboard.writeText(t).then(() => toast(okMsg || 'Copied')); }

(async () => {
  try { await loadVm(); await loadStatus(); }
  catch (e) {
    document.getElementById('pageContent').innerHTML = `<div class="empty-state"><div class="empty-state-title">VM not found</div><div class="empty-state-desc">${escHtml(e.message)}</div><a href="${LIST_URL}" class="btn btn-primary">Back to VMs</a></div>`;
  }
})();
</script>
  <script src="/js/vnm-motion.js" defer></script>
</body>
</html>
